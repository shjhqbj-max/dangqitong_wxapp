<!-- 自定义导航栏（兼容微信原生胶囊） -->
<view class="nav-bar" style="padding-top: {{statusBarHeight}}px; {{bgColor?'background:' + bgColor:' '}};">
	<view class="nav-bar-content" style="height: 44px;">
		<!-- 左侧：返回按钮 或 leftText -->
		<view class="nav-bar-left" wx:if="{{showBack}}" bindtap="onBack">
			<span class="iconfont icon-back nav-bar-back" />
		</view>
		<view class="nav-bar-left" wx:elif="{{leftText}}" bindtap="onLeftTap">
			<span class="nav-bar-left-text" style="{{titleColor ? 'color:' + titleColor : ''}}">{{leftText}}</span>
		</view>
		<view class="nav-bar-left" wx:else></view>

		<!-- 标题（避开胶囊区域） -->
		<view class="nav-bar-title" style="margin-right: {{capsuleWidth + capsuleLeft * 2 + 8}}px; {{titleColor ? 'color:' + titleColor : ''}}">
			<span>{{title}}</span>
		</view>

		<!-- 右侧文字按钮 -->
		<view class="nav-bar-right" wx:if="{{rightText}}" bindtap="onRightTap">
			<span class="nav-bar-right-text">{{rightText}}</span>
		</view>
	</view>

	<!-- 追加内容 -->
	<view class="nav-bar-extra">
		<slot name="extra" />
	</view>
</view>
<!-- 占位撑开 -->
<view class="nav-bar-spacer" style="height: {{statusBarHeight + 44 + extraHeight}}px;" />

