/* ====== 基础 ====== */
page {
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  background: var(--color-bg-page);
  color: var(--color-text-primary);
  font-size: var(--font-md);
  line-height: var(--leading-normal);
  box-sizing: border-box;
}

/* ====== 通用容器 ====== */
.page-container {
  min-height: 100vh;
  background: var(--color-bg-page);
}

/* ====== 卡片 ====== */
.card {
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  padding: var(--space-4);
  box-shadow: var(--shadow-sm);
}

.card-small {
  background: var(--color-bg-card);
  border-radius: var(--radius-md);
  padding: var(--space-3) var(--space-4);
  margin-bottom: var(--space-2);
  box-shadow: var(--shadow-sm);
}

/* 顶部卡片（与 nav-bar 一体的 hero 区域） */
.card-top {
  border-bottom-left-radius: var(--radius-lg);
  border-bottom-right-radius: var(--radius-lg);
  box-shadow: var(--shadow-b);
}

/* ====== 按钮 ====== */
.btn-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--space-2) var(--space-6);
  background: var(--color-primary);
  color: var(--color-on-primary);
  border-radius: var(--radius-md);
  font-size: var(--font-md);
  font-weight: var(--weight-medium);
  border: none;
}

.btn-secondary {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--space-2) var(--space-6);
  background: var(--color-bg-muted);
  color: var(--color-primary);
  border-radius: var(--radius-md);
  font-size: var(--font-md);
  font-weight: var(--weight-medium);
  border: none;
}

.btn-danger {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--space-2) var(--space-6);
  background: var(--color-danger-light);
  color: var(--color-danger);
  border-radius: var(--radius-md);
  font-size: var(--font-md);
  font-weight: var(--weight-medium);
  border: none;
}

/* ====== 状态标签 ====== */
.badge {
  font-size: var(--font-xs);
  padding: 2rpx 12rpx;
  border-radius: var(--radius-full);
  font-weight: var(--weight-medium);
}

.badge-confirmed {
  background: var(--color-danger-light);
  color: var(--color-danger);
}

.badge-pending {
  background: var(--color-warning-light);
  color: var(--color-warning-dark);
}

.badge-rest {
  background: var(--color-neutral-bg);
  color: var(--color-neutral-text);
}

.badge-free {
  background: var(--color-success-light);
  color: var(--color-success-dark);
}

/* 档期进度标签 */
.badge-completed, .tag-completed   { background: var(--color-completed-bg); color: var(--color-success); }
.badge-uncompleted, .tag-uncompleted { background: var(--color-uncompleted-bg); color: var(--color-text-secondary); }
.badge-delayed, .tag-delayed     { background: var(--color-danger-light); color: var(--color-danger); }
.badge-cancelled, .tag-cancelled { background: var(--color-bg-muted); color: var(--color-text-tertiary); }

/* 职业标签 */
.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 12rpx;
  font-size: var(--font-sm);
  font-weight: var(--weight-medium);
}

.tag-blue { background: var(--color-primary-light); color: var(--color-info-dark); }
.tag-green { background: var(--color-success-light); color: var(--color-success-dark); }
.tag-red { background: var(--color-danger-light); color: var(--color-danger-dark); }
.tag-yellow { background: var(--color-warning-light); color: var(--color-warning-dark); }
.tag-gray { background: var(--color-neutral-bg); color: var(--color-neutral-text); }

/* 职业颜色类（对应 --role-* 变量） */
.pro-host     { color: var(--role-host); }
.pro-makeup   { color: var(--role-makeup); }
.pro-video    { color: var(--role-video); }
.pro-photo    { color: var(--role-photo); }
.pro-director { color: var(--role-director); }
.pro-floral   { color: var(--role-floral); }
.pro-lighting { color: var(--role-lighting); }
.pro-setup    { color: var(--role-setup); }
.pro-car      { color: var(--role-car); }
.pro-show     { color: var(--role-show); }

/* 状态指示点 */
.status-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.status-dot-confirmed { background: var(--color-schedule-confirmed); }
.status-dot-pending { background: var(--color-schedule-pending); }
.status-dot-rest { background: var(--color-schedule-rest); }
.status-dot-free { background: var(--color-schedule-free); }

/* ====== 档期列表项（index/search 共用） ====== */
.schedule-item {
  display: flex;
  align-items: center;
  padding: var(--space-3) var(--space-4);
  background: var(--color-bg-card);
  border-radius: var(--radius-md);
  margin-bottom: var(--space-2);
  box-shadow: var(--shadow-sm);
}

.schedule-item-info {
  flex: 1;
  min-width: 0;
}

.schedule-item-title {
  font-size: var(--font-base);
  font-weight: var(--weight-medium);
  color: var(--color-text-primary);
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.schedule-item-meta {
  font-size: var(--font-xs);
  color: var(--color-text-secondary);
  display: block;
  margin-top: var(--space-0-5);
}

.schedule-item-badge {
  flex-shrink: 0;
  font-size: var(--font-xs);
  padding: var(--space-0-5) var(--space-2);
  border-radius: var(--radius-full);
  margin-left: var(--space-1);
}

/* ====== 信息卡片（detail/edit 共用） ====== */
.info-card {
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  padding: var(--space-4);
  margin-top: var(--space-3);
  box-shadow: var(--shadow-sm);
}

.info-card-header {
  display: flex;
  align-items: center;
  gap: var(--space-1);
  margin-bottom: var(--space-3);
}

.info-card-icon {
  font-size: var(--font-md);
  color: var(--color-primary);
}

.info-card-title {
  font-size: var(--font-md);
  font-weight: var(--weight-semibold);
  color: var(--color-text-primary);
  flex: 1;
}

.info-card-row {
  display: flex;
  align-items: center;
  padding: var(--space-2) 0;
  border-bottom: 1rpx solid var(--color-border-light);
}

.info-card-row:last-child {
  border-bottom: none;
}

.info-card-label {
  font-size: var(--font-base);
  color: var(--color-text-tertiary);
  width: 120rpx;
  flex-shrink: 0;
}

.info-card-value {
  flex: 1;
  font-size: var(--font-base);
  color: var(--color-text-primary);
  text-align: right;
}

/* ====== 下拉选择胶囊（detail/edit 共用） ====== */
.completion-pill {
  flex-shrink: 0;
  border-radius: var(--radius-lg);
  background: var(--color-bg-muted);
  overflow: hidden;
  display: flex;
  align-items: center;
  height: 52rpx;
}

.completion-pill-collapsed {
  display: inline-flex;
  align-items: center;
  gap: 4rpx;
  font-size: var(--font-xs);
  padding: 0 14rpx;
  color: var(--color-text-tertiary);
  white-space: nowrap;
  height: 100%;
}

.completion-pill-collapsed:active {
  opacity: 0.7;
}
.completion-pill-arrow {
  font-size: var(--font-xs);
  color: var(--color-text-quaternary);
}

.completion-pill-arrow {
  font-size: var(--font-xs);
  color: var(--color-text-quaternary);
}

.completion-pill-expanded {
  display: flex;
  align-items: center;
}

.completion-pill-menu {
  display: flex;
  align-items: center;
  height: 100%;
}

.completion-pill-option {
  font-size: var(--font-xs);
  font-weight: var(--weight-medium);
  color: var(--color-text-tertiary);
  padding: 0 14rpx;
  white-space: nowrap;
  display: flex;
  align-items: center;
  height: 100%;
}

.completion-pill-option:active {
  opacity: 0.7;
}

.completion-pill-option--active {
  color: var(--color-primary);
}

.completion-pill-divider {
  width: 1rpx;
  height: 24rpx;
  background: var(--color-border-light);
  flex-shrink: 0;
}

.completion-pill-close {
  padding: 0 14rpx;
  display: flex;
  align-items: center;
  height: 100%;
}

.completion-pill-close:active {
  opacity: 0.7;
}

.completion-pill-disabled {
  opacity: 0.5;
  pointer-events: none;
}

/* ====== 费用行（detail/edit 共用） ====== */
.fee-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-2) 0;
  border-bottom: 1rpx solid var(--color-border-light);
}

.fee-row:last-child {
  border-bottom: none;
}

.fee-label {
  font-size: var(--font-base);
  color: var(--color-text-tertiary);
}

/* ====== 付款状态标签 ====== */
.payment-tag {
  display: inline-flex;
  align-items: center;
  font-size: var(--font-xs);
  padding: var(--space-0-5) var(--space-2);
  border-radius: var(--radius-full);
  margin-left: auto;
  flex-shrink: 0;
}

.payment-paid {
  background: var(--color-success-light);
  color: var(--color-success);
}

.payment-partial {
  background: var(--color-warning-light);
  color: var(--color-warning-dark);
}

.payment-unpaid {
  background: var(--color-danger-light);
  color: var(--color-danger);
}

/* ====== 空状态 ====== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--space-10) var(--space-4);
  color: var(--color-text-tertiary);
  font-size: var(--font-base);
}

.empty-title {
  font-size: var(--font-2xl-sm);
  color: var(--color-text-tertiary);
}

/* ====== 渐变 Banner ====== */
.gradient-banner {
  padding: var(--space-3) var(--space-4);
  background: linear-gradient(135deg, var(--color-primary), var(--color-secondary));
  border-radius: var(--radius-lg);
  color: var(--color-on-primary);
}

/* ====== 安全区域 ====== */
.safe-bottom {
  height: calc(180rpx + env(safe-area-inset-bottom, 0px));
}

