/* DQT 档期管理 — 全局 CSS 变量（从 docs/design/css-variables.css 转换） */

page, :host {
  /* ====== 颜色 - 品牌色 ====== */
  --color-primary: #3A6FF7;
  --color-primary-hover: #1D4ED8;
  --color-primary-active: #1E40AF;
  --color-primary-light: #DBEAFE;
  --color-on-primary: #FFFFFF;

  --color-secondary: #3B82F6;
  --color-secondary-hover: #2563EB;
  --color-on-secondary: #FFFFFF;

  /* ====== 颜色 - 语义色 ====== */
  --color-success: #059669;
  --color-success-light: #D1FAE5;
  --color-on-success: #FFFFFF;

  --color-warning: #F59E0B;
  --color-warning-light: #FEF3C7;
  --color-on-warning: #FFFFFF;

  --color-danger: #ff3b30;
  --color-danger-hover: #E5352A;
  --color-danger-light: #FFE5E3;
  --color-on-danger: #FFFFFF;

  --color-info: #2563EB;
  --color-info-light: #DBEAFE;

  /* 语义色深色文字（用于浅色背景标签） */
  --color-success-dark: #065F46;
  --color-warning-dark: #92400E;
  --color-danger-dark: #991B1B;
  --color-info-dark: #1E40AF;

  /* 中性标签 */
  --color-neutral-bg: #F1F5F9;
  --color-neutral-text: #475569;

  /* 完成状态背景 */
  --color-completed-bg: #A7F3D0;
  --color-uncompleted-bg: #E2E8F0;

  /* 状态标签背景 */
  --color-warning-bg: rgba(245, 158, 11, 0.1);
  --color-danger-bg: rgba(239, 68, 68, 0.1);
  --color-success-bg: rgba(34, 197, 94, 0.1);

  /* ====== 颜色 - 档期状态色 ====== */
  --color-schedule-confirmed: #ff3b30;
  --color-schedule-pending: #F59E0B;
  --color-schedule-rest: #9CA3AF;
  --color-schedule-free: #059669;

  /* ====== 颜色 - 背景 ====== */
  --color-bg-page: #F8FAFC;
  --color-bg-card: #FFFFFF;
  --color-bg-muted: #F1F5FD;
  --color-bg-input: #FFFFFF;
  --color-bg-hover: #F1F5F9;
  --color-bg-overlay: rgba(0, 0, 0, 0.5);

  /* ====== 颜色 - 文字 ====== */
  --color-text-primary: #0F172A;
  --color-text-secondary: #64748B;
  --color-text-tertiary: #94A3B8;
  --color-text-placeholder: #CBD5E1;
  --color-text-inverse: #FFFFFF;
  --color-text-link: #2563EB;

  /* ====== 颜色 - 边框 ====== */
  --color-border: #E4ECFC;
  --color-border-light: #F1F5F9;
  --color-border-focus: #2563EB;

  /* ====== 字号 ====== */
  --font-xs: 22rpx;
  --font-sm: 24rpx;
  --font-base: 26rpx;
  --font-md: 30rpx;
  --font-lg: 34rpx;
  --font-xl: 40rpx;
  --font-2xl: 48rpx;
  --font-3xl: 56rpx;
  --font-2xl-sm: 28rpx;
  --font-lg-sm: 32rpx;

  /* ====== 字重 ====== */
  --weight-regular: 400;
  --weight-medium: 500;
  --weight-semibold: 600;
  --weight-bold: 700;

  /* ====== 行高 ====== */
  --leading-tight: 1.3;
  --leading-normal: 1.5;
  --leading-relaxed: 1.75;

  /* ====== 间距（8rpx 基准） ====== */
  --space-1: 8rpx;
  --space-2: 16rpx;
  --space-3: 24rpx;
  --space-4: 32rpx;
  --space-5: 40rpx;
  --space-6: 48rpx;
  --space-8: 64rpx;
  --space-10: 80rpx;
  --space-12: 96rpx;
  --space-2-5: 20rpx;
  --space-1-5: 12rpx;
  --space-0-5: 4rpx;

  /* ====== 圆角 ====== */
  --radius-sm: 14rpx;
  --radius-md: 20rpx;
  --radius-lg: 28rpx;
  --radius-xl: 36rpx;
  --radius-full: 9999rpx;
  --radius-xs: 2rpx;

  /* ====== 阴影 ====== */
  --shadow-sm: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  --shadow-md: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
  --shadow-lg: 0 8rpx 32rpx rgba(0, 0, 0, 0.08);
  --shadow-primary: 0 4rpx 20rpx rgba(58, 111, 247, 0.25);
  --shadow-b: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);

  /* ====== 职业标识色 ====== */
  --role-host: #2563EB;
  --role-makeup: #E11D48;
  --role-video: #7C3AED;
  --role-photo: #0891B2;
  --role-director: #059669;
  --role-floral: #D97706;
  --role-lighting: #EA580C;
  --role-setup: #6D28D9;
  --role-car: #0D9488;
  --role-show: #DB2777;
}

/* ====== 黑夜模式 ====== */
@media (prefers-color-scheme: dark) {
  page, :host {
    /* 颜色 - 品牌色 */
    --color-primary: #60A5FA;
    --color-primary-hover: #3B82F6;
    --color-primary-active: #2563EB;
    --color-primary-light: #1E3A8A;
    --color-on-primary: #FFFFFF;

    --color-secondary: #60A5FA;
    --color-secondary-hover: #3B82F6;
    --color-on-secondary: #FFFFFF;

    /* 颜色 - 语义色 */
    --color-success: #34D399;
    --color-success-light: #064E3B;
    --color-on-success: #FFFFFF;

    --color-warning: #FBBF24;
    --color-warning-light: #78350F;
    --color-on-warning: #000000;

    --color-danger: #F87171;
    --color-danger-hover: #EF4444;
    --color-danger-light: #7F1D1D;
    --color-on-danger: #FFFFFF;

    --color-info: #60A5FA;
    --color-info-light: #1E3A8A;

    /* 语义色深色文字 */
    --color-success-dark: #34D399;
    --color-warning-dark: #FBBF24;
    --color-danger-dark: #F87171;
    --color-info-dark: #60A5FA;

    /* 中性标签 */
    --color-neutral-bg: #334155;
    --color-neutral-text: #CBD5E1;

    /* 完成状态背景 */
    --color-completed-bg: #064E3B;
    --color-uncompleted-bg: #334155;

    /* 状态标签背景 */
    --color-warning-bg: rgba(251, 191, 36, 0.15);
    --color-danger-bg: rgba(248, 113, 113, 0.15);
    --color-success-bg: rgba(52, 211, 153, 0.15);

    /* 颜色 - 档期状态色 */
    --color-schedule-confirmed: #F87171;
    --color-schedule-pending: #FBBF24;
    --color-schedule-rest: #94A3B8;
    --color-schedule-free: #34D399;

    /* 颜色 - 背景 */
    --color-bg-page: #0F172A;
    --color-bg-card: #1E293B;
    --color-bg-muted: #334155;
    --color-bg-input: #1E293B;
    --color-bg-hover: #334155;
    --color-bg-overlay: rgba(0, 0, 0, 0.7);

    /* 颜色 - 文字 */
    --color-text-primary: #F8FAFC;
    --color-text-secondary: #CBD5E1;
    --color-text-tertiary: #94A3B8;
    --color-text-placeholder: #64748B;
    --color-text-inverse: #0F172A;
    --color-text-link: #60A5FA;

    /* 颜色 - 边框 */
    --color-border: #334155;
    --color-border-light: #1E293B;
    --color-border-focus: #60A5FA;

    /* 阴影 */
    --shadow-sm: 0 2rpx 12rpx rgba(0, 0, 0, 0.2);
    --shadow-md: 0 4rpx 20rpx rgba(0, 0, 0, 0.3);
    --shadow-lg: 0 8rpx 32rpx rgba(0, 0, 0, 0.4);
    --shadow-primary: 0 4rpx 20rpx rgba(96, 165, 250, 0.3);
    --shadow-b: 0 2rpx 8rpx rgba(0, 0, 0, 0.2);

    /* 职业标识色（提亮对比度） */
    --role-host: #60A5FA;
    --role-makeup: #FB7185;
    --role-video: #A78BFA;
    --role-photo: #22D3EE;
    --role-director: #34D399;
    --role-floral: #FBBF24;
    --role-lighting: #FB923C;
    --role-setup: #A78BFA;
    --role-car: #2DD4BF;
    --role-show: #F472B6;
  }
}