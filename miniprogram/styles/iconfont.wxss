/* DQT 图标字体 — iconfont.cn */
@font-face {
  font-family: "iconfont"; /* Project id 5161591 */
  src: url('//at.alicdn.com/t/c/font_5161591_fn8cebbrl18.woff2?t=1777209029139') format('woff2'),
       url('//at.alicdn.com/t/c/font_5161591_fn8cebbrl18.woff?t=1777209029139') format('woff'),
       url('//at.alicdn.com/t/c/font_5161591_fn8cebbrl18.ttf?t=1777209029139') format('truetype');
}

.iconfont {
  font-family: "iconfont" !important;
  font-size: inherit;
  font-style: normal;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

