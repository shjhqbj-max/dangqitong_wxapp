<wxs module="h" src="../../utils/helpers.wxs" />
<nav-bar title="抢单列表" bindheight="onNavBarHeight" />

<!-- 统计简报（固定顶部） -->
<view class="pg-stats card-top" style="top: {{navBarHeight-1}}px">
  <view class="pg-stat-item">
    <span class="pg-stat-val">{{stats.total}}</span>
    <span class="pg-stat-label">总发布</span>
  </view>
  <view class="pg-stat-item">
    <span class="pg-stat-val pg-stat-active">{{stats.active}}</span>
    <span class="pg-stat-label">抢单中</span>
  </view>
  <view class="pg-stat-item">
    <span class="pg-stat-val pg-stat-grabbed">{{stats.grabbed}}</span>
    <span class="pg-stat-label">已抢单</span>
  </view>
  <view class="pg-stat-item">
    <span class="pg-stat-val pg-stat-done">{{stats.completed}}</span>
    <span class="pg-stat-label">已完成</span>
  </view>
</view>

<!-- 工单列表 -->
<view class="pg-body">
  <view class="pg-item card" wx:for="{{orderList}}" wx:key="order_id" data-id="{{item.order_id}}" bindtap="onOrderTap">
    <view class="pg-item-date">
      <span class="pg-item-day">{{h.getDayNum(item.date)}}</span>
      <span class="pg-item-month">{{h.getMonth(item.date)}}月</span>
    </view>
    <view class="pg-item-info">
      <span class="pg-item-title">{{h.formatProfessionSummary(item.profession_slots)}}</span>
      <span class="pg-item-loc" wx:if="{{item.location}}">{{item.location}}</span>
    </view>
    <view class="pg-item-grab" wx:if="{{item.grab_count > 0}}">{{item.grab_count}}人抢单</view>
  </view>

  <!-- 加载状态 -->
  <view class="pg-loading" wx:if="{{loadingMore}}">
    <span>加载中...</span>
  </view>
  <view class="pg-no-more" wx:if="{{!hasMore && orderList.length > 0}}">
    <span>没有更多了</span>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{!loading && orderList.length === 0}}">
    <span class="iconfont icon-order empty-icon"></span>
    <span class="empty-title">暂无发布工单</span>
  </view>

  <view class="safe-bottom" />
</view>
