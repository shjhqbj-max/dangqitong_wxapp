/* 档期编辑页 */
.edit-page {
  min-height: 100vh;
}

/* ====== Hero 头部（与 nav-bar 一体） ====== */
.edit-hero {
  position: fixed;
  top: -1px;
  left: 0;
  right: 0;
  z-index: 50;
  background: var(--color-bg-card);
  box-shadow: var(--shadow-b);
}

.hero-content {
  padding: var(--space-4) var(--space-4) var(--space-3);
}

.hero-top {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: var(--space-2-5);
}

.hero-date {
  display: flex;
  align-items: flex-end;
  gap: var(--space-1-5);
}

.hero-date-day {
  font-size: 96rpx;
  font-weight: var(--weight-bold);
  line-height: 1;
  color: var(--color-primary);
}

.hero-date-edit {
  font-size: var(--font-sm);
  color: var(--color-primary);
  opacity: 0.6;
  margin-left: var(--space-0-5);
}

.hero-date-sub {
  font-size: var(--font-base);
  color: var(--color-text-secondary);
  padding-bottom: var(--space-1-5);
  display: flex;
  align-items: center;
}

.hero-badges {
  display: flex;
  gap: var(--space-1);
  flex-wrap: wrap;
  padding-bottom: var(--space-1-5);
}

.hero-badge {
  display: inline-flex;
  align-items: center;
  font-size: var(--font-sm);
  padding: var(--space-0-5) var(--space-2);
  border-radius: var(--radius-full);
}

.hero-badge-arrow {
  font-size: 20rpx;
  margin-left: 4rpx;
  opacity: 0.7;
}

.hero-meta {
  display: flex;
  align-items: center;
}

.hero-time-capsule {
  display: inline-flex;
  align-items: center;
  gap: var(--space-1);
  padding: var(--space-1) var(--space-2-5);
  background: var(--color-primary-light);
  border-radius: var(--radius-full);
}

.hero-time-text {
  font-size: var(--font-md);
  color: var(--color-primary);
  font-weight: var(--weight-medium);
}

.hero-time-sep {
  font-size: var(--font-sm);
  color: var(--color-primary);
  opacity: 0.5;
}

.hero-time-edit {
  font-size: var(--font-xs);
  color: var(--color-primary);
  opacity: 0.6;
}

.hero-actions {
  display: flex;
  gap: var(--space-2);
  margin-top: var(--space-3);
  padding-top: var(--space-3);
  border-top: 1rpx solid var(--color-border-light);
}

.hero-action-btn {
  flex: 1;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-lg);
  font-size: var(--font-base);
  font-weight: var(--weight-medium);
  background: var(--color-bg-muted);
  color: var(--color-text-primary);
}

.hero-action-btn-save {
  background: var(--color-primary);
  color: var(--color-on-primary);
  box-shadow: var(--shadow-primary);
}

/* ====== 内容区 ====== */
.edit-body {
  padding: 0 var(--space-3);
}

/* ====== 表单行 ====== */
.form-row {
  display: flex;
  align-items: center;
  padding: var(--space-2) 0;
}

.form-row-last {
}

.form-label {
  font-size: var(--font-base);
  color: var(--color-text-tertiary);
  width: 120rpx;
  flex-shrink: 0;
}

.form-input {
  flex: 1;
  height: 72rpx;
  font-size: var(--font-base);
  color: var(--color-text-primary);
  text-align: right;
  padding: 0 var(--space-2);
  border-bottom: 2rpx solid var(--color-border-light);
  transition: border-color 0.2s;
}

.form-input:focus {
  border-bottom-color: var(--color-primary);
}

.form-input-group {
  flex: 1;
  display: flex;
  align-items: center;
  gap: var(--space-1);
}

.form-input-group .form-input {
  flex: 1;
}

.form-location-btn {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-primary-light);
  border-radius: var(--radius-sm);
  flex-shrink: 0;
}

.form-location-icon {
  font-size: var(--font-md);
  color: var(--color-primary);
}

/* ====== 附加联系人 ====== */
.form-add-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-full);
  background: var(--color-primary-light);
  margin-left: auto;
}

.form-add-icon {
  font-size: var(--font-md);
  color: var(--color-primary);
}

.form-empty {
  padding: var(--space-4) 0;
  text-align: center;
}

.form-empty-text {
  font-size: var(--font-sm);
  color: var(--color-text-placeholder);
}

.contact-row {
  display: flex;
  align-items: center;
  gap: var(--space-1);
  padding: var(--space-1-5) 0;
  border-bottom: 1rpx solid var(--color-border-light);
}

.contact-row:last-child {
  border-bottom: none;
}

.contact-role {
  width: 120rpx;
  flex-shrink: 0;
  height: 64rpx;
  font-size: var(--font-sm);
  color: var(--color-text-primary);
  background: var(--color-bg-muted);
  border-radius: var(--radius-sm);
  padding: 0 var(--space-1);
  text-align: center;
}

.contact-name {
  flex: 1;
  height: 64rpx;
  font-size: var(--font-sm);
  color: var(--color-text-primary);
  background: var(--color-bg-muted);
  border-radius: var(--radius-sm);
  padding: 0 var(--space-2);
}

.contact-phone {
  width: 180rpx;
  flex-shrink: 0;
  height: 64rpx;
  font-size: var(--font-sm);
  color: var(--color-text-primary);
  background: var(--color-bg-muted);
  border-radius: var(--radius-sm);
  padding: 0 var(--space-2);
}

.contact-del {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border-radius: var(--radius-full);
  background: var(--color-danger-light);
}

.contact-del .iconfont {
  font-size: var(--font-sm);
  color: var(--color-danger);
}

/* ====== 备注 ====== */
.form-textarea {
  width: 100%;
  min-height: 160rpx;
  padding: var(--space-2);
  background: var(--color-bg-muted);
  border-radius: var(--radius-sm);
  font-size: 28rpx;
  color: var(--color-text-primary);
  line-height: 1.6;
  box-sizing: border-box;
}
