
/* ====== 日历区域（与 nav-bar 一体） ====== */
.c-calendar {
  padding: var(--space-2) var(--space-1) var(--space-4);
  background: var(--color-bg-card);
  position: relative;
}

.c-cal-weekdays {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  text-align: center;
}

.c-cal-weekday {
  font-size: var(--font-sm);
  color: var(--color-text-tertiary);
  font-weight: var(--weight-medium);
  padding: var(--space-1) 0 var(--space-1-5);
}

.c-cal-weekday.wknd {
  color: var(--color-danger);
}

.c-cal-swiper {
  height: 40vh;
}

.c-cal-days {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  grid-template-rows: repeat(5, 1fr);
  height: 100%;
  gap: var(--space-0-5);
}

.c-cal-cell {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-lg);
  font-size: var(--font-2xl-sm);
  position: relative;
  margin: var(--space-0-5);
  transition: background 0.15s;
}

.c-cal-cell.today {
  background: var(--color-primary);
  color: var(--color-on-primary);
  font-weight: var(--weight-semibold);
}

.c-cal-cell.selected {
  background: var(--color-primary-light);
  color: var(--color-primary-active);
  font-weight: var(--weight-semibold);
}

.c-cal-cell.other-month {
  color: var(--color-text-placeholder);
}

/* 状态指示点（替代原来的横条） */
.c-cal-dot-row {
  display: flex;
  gap: 6rpx;
  margin-top: 6rpx;
  position: absolute;
  bottom: 10rpx;
}

.c-cal-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
}

.dot-conf { background: var(--color-schedule-confirmed); }
.dot-pend { background: var(--color-schedule-pending); }
.dot-rest { background: var(--color-schedule-rest); }

/* ====== 档期列表区域 ====== */
.c-body {
  padding: 0 var(--space-3) var(--space-3);
  min-height: 100vh;
}

.c-body-header {
  display: flex;
  flex-direction: column;
  gap: var(--space-1);
  padding: var(--space-3) var(--space-3) var(--space-2);
}

.c-body-header.c-header-sticky {
  position: fixed;
  left: 0;
  right: 0;
  z-index: 100;
  background: var(--color-bg-card);
  padding: var(--space-2) var(--space-3);
}

.c-body-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.c-body-title-wrap {
  display: flex;
  align-items: center;
  min-height: var(--space-6);
}

.c-body-title {
  font-size: var(--font-lg);
  font-weight: var(--weight-semibold);
  color: var(--color-text-primary);
}

.c-date-title {
  display: flex;
  align-items: center;
  gap: var(--space-1);
  font-size: var(--font-lg);
  font-weight: var(--weight-semibold);
  color: var(--color-primary);
}

.c-date-close {
  font-size: var(--font-base);
  color: var(--color-text-tertiary);
  padding: var(--space-0-5);
}

.c-body-tabs {
  display: flex;
  gap: var(--space-1);
  align-items: center;
}

.c-text-btn {
  font-size: var(--font-xs);
  padding: var(--space-1) var(--space-2);
  border-radius: var(--radius-full);
  color: var(--color-text-secondary);
  background: var(--color-bg-card);
  box-shadow: var(--shadow-sm);
}

.c-text-btn.active {
  background: var(--color-primary);
  color: var(--color-on-primary);
  box-shadow: var(--shadow-primary);
}

.c-tab {
  font-size: var(--font-xs);
  padding: var(--space-1) var(--space-2-5);
  border-radius: var(--radius-full);
  color: var(--color-text-secondary);
  background: var(--color-bg-card);
  box-shadow: var(--shadow-sm);
}

.c-tab.active {
  background: var(--color-primary);
  color: var(--color-on-primary);
  box-shadow: var(--shadow-primary);
}

/* ====== 广场入口 ====== */
.c-mini-banner {
  margin-bottom: var(--space-2);
  padding: var(--space-3) var(--space-4);
  background: linear-gradient(135deg, var(--color-primary), #5B8DF7);
  border-radius: var(--radius-lg);
  color: var(--color-on-primary);
  box-shadow: var(--shadow-primary);
}

.c-ban-content {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.c-ban-right {
  display: flex;
  align-items: center;
  gap: var(--space-2);
}

.c-ban-close {
  font-size: var(--font-lg);
  color: var(--color-on-primary);
  opacity: 0.6;
  padding: var(--space-0-5);
}

.c-ban-title {
  font-size: var(--font-base);
  font-weight: var(--weight-semibold);
  color: var(--color-on-primary);
  display: block;
}

.c-ban-desc {
  font-size: var(--font-xs);
  opacity: 0.8;
  color: var(--color-on-primary);
  display: block;
  margin-top: 2rpx;
}

.c-ban-btn {
  font-size: var(--font-xs);
  padding: var(--space-1) var(--space-3);
  background: rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(4px);
  color: var(--color-on-primary);
  border-radius: var(--radius-full);
  font-weight: var(--weight-medium);
}

/* ====== 筛选标签 ====== */
.c-filter-tags {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-1);
  padding: 0 var(--space-3) var(--space-2);
}

.c-filter-tag {
  display: flex;
  align-items: center;
  gap: var(--space-0-5);
  font-size: var(--font-xs);
  color: var(--color-primary);
  background: var(--color-primary-light);
  padding: var(--space-0-5) var(--space-2);
  border-radius: var(--radius-full);
  border: 1rpx solid var(--color-primary);
}

.c-tag-close {
  font-size: var(--font-md);
  line-height: 1;
  margin-left: 2rpx;
}

/* ====== 筛选面板 ====== */
.filter-overlay {
  position: fixed;
  inset: 0;
  background: var(--color-bg-overlay);
  z-index: 950;
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.25s ease, visibility 0.25s ease;
}

.filter-overlay.show {
  opacity: 1;
  visibility: visible;
}

.filter-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--color-bg-card);
  border-top-left-radius: var(--radius-xl);
  border-top-right-radius: var(--radius-xl);
  z-index: 960;
  transform: translateY(100%);
  transition: transform 0.3s cubic-bezier(0.32, 0.72, 0, 1);
  max-height: 70vh;
  display: flex;
  flex-direction: column;
}

.filter-sheet.show {
  transform: translateY(0);
}

.filter-sheet-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--space-4) var(--space-4) var(--space-3);
  flex-shrink: 0;
}

.filter-sheet-title {
  font-size: var(--font-lg);
  font-weight: var(--weight-semibold);
  color: var(--color-text-primary);
}

.filter-sheet-close {
  font-size: var(--font-lg);
  color: var(--color-text-tertiary);
  padding: var(--space-1);
}

.filter-sheet-body {
  padding: 0 var(--space-4);
  box-sizing: border-box;
}

.filter-group {
  margin-bottom: var(--space-4);
}

.filter-group-label {
  font-size: var(--font-base);
  font-weight: var(--weight-medium);
  color: var(--color-text-secondary);
  margin-bottom: var(--space-2);
}

.filter-options {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-1-5);
}

.filter-option {
  font-size: var(--font-sm);
  padding: var(--space-1-5) var(--space-3);
  border-radius: var(--radius-full);
  color: var(--color-text-secondary);
  background: var(--color-bg-muted);
  border: 1rpx solid transparent;
}

.filter-option.active {
  color: var(--color-primary);
  background: var(--color-primary-light);
  border-color: var(--color-primary);
}

.filter-switch-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: var(--font-base);
  color: var(--color-text-secondary);
}

.filter-switch-row switch {
  flex-shrink: 0;
  transform: scale(0.8);
  transform-origin: right center;
}

.filter-sheet-footer {
  display: flex;
  gap: var(--space-2);
  padding: var(--space-3) var(--space-4);
  padding-bottom: calc(var(--space-3) + env(safe-area-inset-bottom, 0px));
  flex-shrink: 0;
}

.filter-btn-reset {
  flex: 1;
  text-align: center;
  font-size: var(--font-base);
  padding: var(--space-2-5) 0;
  border-radius: var(--radius-lg);
  background: var(--color-bg-muted);
  color: var(--color-text-secondary);
  font-weight: var(--weight-medium);
}

.filter-btn-confirm {
  flex: 2;
  text-align: center;
  font-size: var(--font-base);
  padding: var(--space-2-5) 0;
  border-radius: var(--radius-lg);
  background: var(--color-primary);
  color: var(--color-on-primary);
  font-weight: var(--weight-semibold);
}

/* ====== 空状态 ====== */
.empty-icon {
  font-size: 80rpx;
  color: var(--color-text-placeholder);
  margin-bottom: var(--space-3);
}
