/* 档期详情页 */
.detail-page {
  min-height: 100vh;
}

/* ====== Hero 头部（与 nav-bar 一体） ====== */
.detail-hero {
  position: fixed;
  top: -1px;
  left: 0;
  right: 0;
  z-index: 50;
  background: var(--color-bg-card);
  box-shadow: var(--shadow-b);
}
.completion-pill-close-icon{
  color: var(--color-text-secondary);
}
.completion-pill{
  padding: 0 var(--space-1);
}
.hero-content {
  padding: var(--space-4) var(--space-4) var(--space-3);
}

.hero-top {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: var(--space-2-5);
}

.hero-date {
  display: flex;
  align-items: flex-end;
  gap: var(--space-1-5);
}

.hero-date-day {
  font-size: 96rpx;
  font-weight: var(--weight-bold);
  line-height: 1;
  color: var(--color-text-primary);
}

.hero-date-info {
  display: flex;
  flex-direction: column;
  gap: var(--space-1);
  padding-bottom: var(--space-1-5);
}

.hero-date-sub {
  font-size: var(--font-base);
  color: var(--color-text-secondary);
}

.hero-date-badges {
  display: flex;
  gap: var(--space-1);
  align-items: center;
}

.hero-badge {
  display: inline-flex;
  align-items: center;
  font-size: var(--font-sm);
  padding: var(--space-0-5) var(--space-2);
  border-radius: var(--radius-full);
}

.hero-meta {
  display: flex;
  align-items: center;
  gap: var(--space-2);
}

.hero-time-row {
  display: flex;
  align-items: center;
  gap: var(--space-1);
}

.hero-meta-icon {
  font-size: var(--font-sm);
  color: var(--color-text-tertiary);
}

.hero-time-text {
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
}

.hero-actions {
  display: flex;
  gap: var(--space-2);
  margin-top: var(--space-3);
  padding-top: var(--space-3);
  border-top: 1rpx solid var(--color-border-light);
}

.hero-action-btn {
  flex: 1;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-lg);
  font-size: var(--font-base);
  font-weight: var(--weight-medium);
  background: var(--color-bg-muted);
  color: var(--color-text-primary);
}

.hero-action-btn-main {
  flex: 4;
}

.hero-action-btn-delete {
  flex: 2;
  background: var(--color-danger-light);
  color: var(--color-danger);
}

.hero-action-btn-assign {
  flex: 2;
  background: var(--color-primary-light);
  color: var(--color-primary);
}

.hero-action-btn-accept {
  background: var(--color-success-light);
  color: var(--color-success);
}

.hero-action-btn-reject {
  background: var(--color-danger-light);
  color: var(--color-danger);
}

/* ====== 内容区 ====== */
.detail-body {
  padding: 0 var(--space-3);
}

/* ====== 电话链接 ====== */
.info-card-phone {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: var(--space-1);
  color: var(--color-primary);
  font-size: var(--font-base);
}

/* ====== 付款 Toggle 开关 ====== */
.payment-toggle {
  display: inline-flex;
  align-items: center;
  height: 44rpx;
  padding: 0 4rpx;
  border-radius: var(--radius-full);
  background: var(--color-border);
  margin-left: auto;
  flex-shrink: 0;
  transition: background 0.25s;
}

.payment-toggle-thumb {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: var(--color-bg-card);
  box-shadow: var(--shadow-sm);
  flex-shrink: 0;
  transition: all 0.25s;
}

.payment-toggle-text {
  font-size: 18rpx;
  font-weight: var(--weight-medium);
  color: var(--color-text-tertiary);
  padding: 0 var(--space-1);
  transition: color 0.25s;
  white-space: nowrap;
}

.payment-toggle-on {
  background: var(--color-primary);
  flex-direction: row-reverse;
}

.payment-toggle-on .payment-toggle-text {
  color: var(--color-on-primary);
}

.payment-toggle-disabled {
  opacity: 0.5;
  pointer-events: none;
}

.payment-toggle:active {
  opacity: 0.8;
}

/* ====== 费用 ====== */
.fee-total {
  font-size: var(--font-xl);
  font-weight: var(--weight-bold);
  color: var(--color-text-primary);
}

.fee-value {
  font-size: var(--font-base);
  font-weight: var(--weight-medium);
  color: var(--color-text-primary);
}

/* ====== 备注 ====== */
.notes-content {
  font-size: 28rpx;
  color: var(--color-text-primary);
  line-height: 1.6;
  white-space: pre-wrap;
}

/* ====== 操作链接 ====== */
.action-links {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--space-3) 0;
  margin-top: var(--space-3);
}

.action-link {
  font-size: var(--font-base);
  color: var(--color-text-tertiary);
  padding: var(--space-1) var(--space-2-5);
  font-weight: var(--weight-medium);
  display: inline-flex;
  align-items: center;
  gap: var(--space-1);
}

.action-link-icon {
  font-size: var(--font-sm);
}

.action-link-active {
  color: var(--color-primary);
}

.action-link-divider {
  width: 1rpx;
  height: 24rpx;
  margin: 0 var(--space-1);
}

/* ====== 浮动输入条 ====== */
.float-bar-mask {
  position: fixed;
  inset: 0;
  z-index: 500;
  background: rgba(0, 0, 0, 0.3);
}

.float-bar {
  position: fixed;
  left: 0;
  right: 0;
  z-index: 510;
  background: var(--color-bg-card);
  border-top: 1rpx solid var(--color-border-light);
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.06);
  padding-bottom: env(safe-area-inset-bottom, 0px);
  padding-top: var(--space-1-5);
}

.float-bar-inner {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  padding: var(--space-2) var(--space-3);
}

.float-bar-input-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  background: var(--color-bg-muted);
  padding: 0 var(--space-4);
  border-radius: var(--radius-lg);
}
.info-card-label-hidden{
  width: 120rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.float-bar-input {
  flex: 1;
  height: 72rpx;
  font-size: 28rpx;
  color: var(--color-text-primary);
  text-align: center;
}

.float-bar-unit {
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  flex-shrink: 0;
}

/* ====== 指派面板 ====== */
.assign-mask {
  position: fixed;
  inset: 0;
  z-index: 500;
  background: rgba(0, 0, 0, 0.3);
}

.assign-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 510;
  background: var(--color-bg-card);
  border-radius: var(--radius-xl) var(--radius-xl) 0 0;
  box-shadow: 0 -8rpx 32rpx rgba(0, 0, 0, 0.08);
  transform: translateY(100%);
  transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  max-height: 75vh;
  display: flex;
  flex-direction: column;
}

.assign-sheet-open {
  transform: translateY(0);
}

.assign-sheet-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-4) var(--space-4) var(--space-3);
  flex-shrink: 0;
}

.assign-sheet-title {
  font-size: var(--font-lg);
  font-weight: var(--weight-semibold);
  color: var(--color-text-primary);
}

.assign-sheet-close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-full);
  background: var(--color-bg-muted);
}

.assign-sheet-close .iconfont {
  font-size: var(--font-base);
  color: var(--color-text-tertiary);
}

.assign-sheet-body {
  flex: 1;
  overflow-y: auto;
  padding: 0 var(--space-4);
}

.assign-team {
  margin-bottom: var(--space-3);
}

.assign-team-header {
  display: flex;
  align-items: center;
  padding: var(--space-2) 0;
  gap: var(--space-1);
}

.assign-team-name {
  font-size: var(--font-base);
  font-weight: var(--weight-semibold);
  color: var(--color-text-primary);
}

.assign-team-count {
  font-size: var(--font-xs);
  color: var(--color-text-tertiary);
  margin-left: var(--space-1);
}

.assign-team-check {
  margin-left: auto;
  font-size: var(--font-lg);
  color: var(--color-border);
  transition: color 0.15s;
}

.assign-team-check-on {
  color: var(--color-primary);
}

.assign-member {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  padding: var(--space-2) var(--space-2);
  border-radius: var(--radius-md);
  margin-bottom: 2rpx;
  transition: background 0.15s;
}

.assign-member:active {
  background: var(--color-bg-muted);
}

.assign-member-checked {
  background: var(--color-primary-light);
}

.assign-member-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: var(--radius-full);
  background: var(--color-primary-light);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  overflow: hidden;
}

.assign-member-initial {
  font-size: var(--font-base);
  font-weight: var(--weight-semibold);
  color: var(--color-primary);
}

.assign-member-img {
  width: 72rpx;
  height: 72rpx;
}

.assign-member-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}

.assign-member-name {
  font-size: var(--font-base);
  color: var(--color-text-primary);
  font-weight: var(--weight-medium);
}

.assign-member-role {
  font-size: var(--font-xs);
  color: var(--color-text-tertiary);
}

.assign-member-check {
  flex-shrink: 0;
}

.assign-member-check .iconfont {
  font-size: var(--font-xl);
  color: var(--color-border);
  transition: color 0.15s;
}

.assign-member-checked .assign-member-check .iconfont {
  color: var(--color-primary);
}

.assign-empty {
  padding: var(--space-8) 0;
  text-align: center;
}

.assign-empty-text {
  font-size: var(--font-sm);
  color: var(--color-text-placeholder);
}

/* 指派底部栏 */
.assign-sheet-footer {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  padding: var(--space-3) var(--space-4);
  padding-bottom: calc(var(--space-3) + env(safe-area-inset-bottom, 0px));
  border-top: 1rpx solid var(--color-border-light);
  flex-shrink: 0;
}

.assign-selected-info {
  flex: 1;
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
}

.assign-selected-hint {
  color: var(--color-text-placeholder);
}

.assign-confirm-btn {
  height: 72rpx;
  padding: 0 var(--space-6);
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-lg);
  font-size: var(--font-base);
  font-weight: var(--weight-semibold);
  background: var(--color-bg-muted);
  color: var(--color-text-tertiary);
  transition: all 0.2s;
}

.assign-confirm-active {
  background: var(--color-primary);
  color: var(--color-on-primary);
  box-shadow: var(--shadow-primary);
}
