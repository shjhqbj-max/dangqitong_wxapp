<wxs module="h" src="../../utils/helpers.wxs" />

<!-- 顶部快捷入口 -->
<view class="sys-header card-top">
</view>

<!-- 通知列表 -->
<view class="sys-body">
  <view class="sys-item card" wx:for="{{notifications}}" wx:key="notification_id"
        data-type="{{item.type}}" data-extra="{{item.extra_data}}" bindtap="onNotiTap">
    <view class="sys-item-header">
      <span class="sys-item-title">{{item.title}}</span>
      <span class="sys-item-time">{{h.timeAgo(item.created_at)}}</span>
    </view>
    <view class="sys-item-content">{{item.content}}</view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{!loading && notifications.length === 0}}">
    <span class="iconfont icon-notification empty-icon"></span>
    <span class="empty-title">暂无系统消息</span>
  </view>

  <view class="safe-bottom" />
</view>
