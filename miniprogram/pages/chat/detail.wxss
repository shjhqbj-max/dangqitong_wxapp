/* 聊天详情页 */

page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--color-bg-page);
}

.ch-scroll-wrap {
  flex: 1;
  min-height: 0;
  overflow: hidden;
  padding: var(--space-3);
  padding-top: 0px;
}

.ch-scroll {
  height: 100%;
}

/* ====== 顶部信息卡片 ====== */
.ch-header-card {
  flex-shrink: 0;
  background: var(--color-bg-card);
  border-bottom: 1rpx solid var(--color-border-light);
}

.ch-card-schedule,
.ch-card-team {
  padding: var(--space-3) var(--space-4);
}

.ch-card-private {
  padding: var(--space-2) var(--space-4);
}

/* ====== 私聊安全提醒 ====== */
.ch-card-warn {
  display: flex;
  align-items: flex-start;
  gap: var(--space-1-5);
}

.ch-card-warn-icon {
  font-size: var(--font-sm);
  color: var(--color-text-tertiary);
  flex-shrink: 0;
  margin-top: 2rpx;
}

.ch-card-warn-text {
  font-size: var(--font-xs);
  color: var(--color-text-tertiary);
  line-height: 1.6;
}

.ch-card-row {
  display: flex;
  align-items: center;
  gap: var(--space-2);
}

.ch-card-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.ch-card-title {
  font-size: var(--font-base);
  font-weight: var(--weight-medium);
  color: var(--color-text-primary);
}

.ch-card-sub {
  font-size: var(--font-sm);
  color: var(--color-text-tertiary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ch-card-meta {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  margin-top: var(--space-2);
}

.ch-card-tag {
  font-size: var(--font-xs);
  padding: var(--space-0-5) var(--space-2);
  border-radius: var(--radius-full);
  background: var(--color-bg-muted);
  color: var(--color-text-secondary);
}

.ch-card-tag.badge-confirmed {
  background: var(--color-success-light);
  color: var(--color-success);
}

.ch-card-tag.badge-pending {
  background: var(--color-warning-light);
  color: var(--color-warning-dark);
}

.ch-card-tag.badge-rest {
  background: var(--color-neutral-bg);
  color: var(--color-neutral-text);
}

/* ====== 档期群卡片：左信息 + 右按钮 ====== */
.ch-schedule-main {
  display: flex;
  align-items: center;
}

.ch-schedule-info {
  flex: 1;
  min-width: 0;
}

.ch-member-btn {
  display: flex;
  align-items: center;
  gap: 4rpx;
  flex-shrink: 0;
  margin-left: var(--space-3);
  padding: var(--space-1) 0;
}

.ch-member-btn:active {
  opacity: 0.6;
}

.ch-member-btn-icon {
  font-size: var(--font-xs);
  color: var(--color-text-tertiary);
}

.ch-member-btn-text {
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  white-space: nowrap;
}

/* ====== 团队群卡片：左统计 + 右链接 ====== */
.ch-card-team {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.ch-team-stats {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.ch-team-stats-row {
  font-size: var(--font-sm);
  color: var(--color-text-primary);
}

.ch-team-stats-sub {
  font-size: var(--font-xs);
  color: var(--color-text-tertiary);
}

.ch-team-link {
  display: flex;
  align-items: center;
  gap: 4rpx;
  flex-shrink: 0;
  margin-left: var(--space-3);
  padding: var(--space-1) var(--space-2);
  border-radius: var(--radius-md);
}

.ch-team-link:active {
  background: var(--color-bg-muted);
}

.ch-team-link-text {
  font-size: var(--font-sm);
  color: var(--color-primary);
  white-space: nowrap;
}

.ch-team-link-icon {
  font-size: var(--font-sm);
  color: var(--color-primary);
}

/* ====== 成员弹出面板 ====== */
.ch-member-panel-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 100;
}

.ch-member-panel {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  background: var(--color-bg-card);
  border-radius: 0 0 var(--radius-xl) var(--radius-xl);
  z-index: 101;
  max-height: 60vh;
  transform: translateY(-100%);
  transition: transform 0.3s ease;
  display: flex;
  flex-direction: column;
}

.ch-member-panel-show {
  transform: translateY(0);
}

.ch-member-panel-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-3) var(--space-4);
  border-bottom: 1rpx solid var(--color-border-light);
  flex-shrink: 0;
}

.ch-member-panel-title {
  font-size: var(--font-base);
  font-weight: var(--weight-medium);
  color: var(--color-text-primary);
}

.ch-member-panel-close {
  font-size: var(--font-lg);
  color: var(--color-text-tertiary);
  padding: var(--space-1);
}

.ch-member-panel-list {
  flex: 1;
  overflow-y: auto;
  padding: var(--space-2) var(--space-4);
}

.ch-member-panel-item {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  padding: var(--space-2-5) 0;
  border-bottom: 1rpx solid var(--color-border-light);
}

.ch-member-panel-item:last-child {
  border-bottom: none;
}

.ch-member-panel-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: var(--radius-full);
  flex-shrink: 0;
}

.ch-member-panel-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.ch-member-panel-name {
  font-size: var(--font-base);
  color: var(--color-text-primary);
}

.ch-member-panel-pro {
  font-size: var(--font-xs);
  color: var(--color-text-tertiary);
}

/* ====== 时间分割线 ====== */
.ch-msg-time {
  text-align: center;
  font-size: var(--font-xs);
  color: var(--color-text-tertiary);
  padding: var(--space-2) 0 var(--space-3);
}

/* ====== 系统消息 ====== */
.ch-msg-system {
  text-align: center;
  padding: var(--space-1) 0;
}

.ch-msg-system-text {
  display: inline-block;
  font-size: var(--font-xs);
  color: var(--color-text-tertiary);
  background: var(--color-bg-muted);
  border-radius: var(--radius-sm);
  padding: var(--space-1) var(--space-2);
}

/* ====== 消息行 ====== */
.ch-msg-row {
  display: flex;
  align-items: flex-start;
  gap: var(--space-2);
  margin-bottom: var(--space-3);
}

.ch-msg-self {
  flex-direction: row-reverse;
}

.ch-msg-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: var(--radius-full);
  flex-shrink: 0;
}

/* ====== 消息气泡 ====== */
.ch-msg-bubble {
  max-width: 65%;
  padding: var(--space-2) var(--space-3);
  border-radius: var(--radius-lg);
  background: var(--color-bg-card);
  font-size: var(--font-base);
  color: var(--color-text-primary);
  line-height: 1.5;
  word-break: break-all;
  box-shadow: var(--shadow-sm);
}

.ch-msg-self .ch-msg-bubble {
  background: var(--color-primary);
  color: var(--color-on-primary);
  border-bottom-right-radius: var(--space-1);
}

.ch-msg-row:not(.ch-msg-self) .ch-msg-bubble {
  border-bottom-left-radius: var(--space-1);
}

/* 图片消息 */
.ch-msg-img {
  width: 360rpx;
  border-radius: var(--radius-md);
  display: block;
}

/* 位置消息 */
.ch-msg-location {
  display: flex;
  align-items: center;
  gap: var(--space-1);
}

.ch-msg-location-icon {
  font-size: var(--font-md);
  color: var(--color-primary);
}

.ch-msg-self .ch-msg-location-icon {
  color: var(--color-on-primary);
}

.ch-msg-location-text {
  font-size: var(--font-sm);
}

/* ====== 底部输入栏 ====== */
.ch-input-bar {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: var(--space-2);
  padding: var(--space-2) var(--space-3);
  background: var(--color-bg-card);
  border-top: 1rpx solid var(--color-border-light);
  transition: padding-bottom 0.2s;
}

.ch-input {
  flex: 1;
  height: 72rpx;
  background: var(--color-bg-muted);
  border-radius: var(--radius-full);
  padding: 0 var(--space-3);
  font-size: var(--font-base);
  color: var(--color-text-primary);
}

.ch-input-actions {
  display: flex;
  align-items: center;
  gap: var(--space-2);
}

.ch-input-icon {
  font-size: var(--font-xl);
  color: var(--color-text-secondary);
  padding: var(--space-1);
}

.ch-input-icon:active {
  opacity: 0.6;
}
