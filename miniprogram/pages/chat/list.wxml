<wxs module="h" src="../../utils/helpers.wxs" />
<nav-bar left-text="消息" left-icon="icon-search" bind:lefttap="onSearchTap" bindheight="onNavBarHeight" />

<!-- 搜索+系统消息 hero 区域 -->
<view class="ch-hero card-top" style="top: {{navBarHeight-1}}px">
  <!-- 默认：系统消息 -->
  <view class="ch-hero-default" wx:if="{{!showSearch}}">
    <view class="ch-notify-entry" bindtap="onNotifyCardTap" wx:if="{{notifications.length > 0}}">
      <view class="ch-notify-entry-icon-wrap">
        <span class="iconfont icon-notification ch-notify-entry-icon"></span>
        <span class="ch-notify-entry-badge" wx:if="{{unreadNotiCount > 0}}">{{unreadNotiCount}}</span>
      </view>
      <view class="ch-notify-entry-body">
        <span class="ch-notify-entry-label">系统消息</span>
        <span class="ch-notify-entry-latest" wx:if="{{notifications[0]}}">{{notifications[0].title}}</span>
      </view>
      <span class="iconfont icon-chevron-right ch-notify-entry-arrow"></span>
    </view>
  </view>
  <!-- 搜索态：输入框 + 关闭按钮 -->
  <view class="ch-hero-search" wx:if="{{showSearch}}">
    <view class="ch-search-active">
      <span class="iconfont icon-search ch-search-icon"></span>
      <input class="ch-search-input" value="{{searchKey}}" placeholder="搜索聊天记录" focus="{{showSearch}}"
        bindinput="onSearchInput" confirm-type="search" />
      <view class="ch-search-clear" wx:if="{{searchKey.length > 0}}" bindtap="onSearchClear">
        <span class="iconfont icon-close ch-search-clear-icon"></span>
      </view>
    </view>
    <span class="ch-search-cancel" bindtap="onSearchClose">取消</span>
  </view>
</view>

<!-- 聊天列表 -->
<view class="ch-body">
  <view class="ch-item card" wx:for="{{chats}}" wx:key="chat_id"
        data-id="{{item.chat_id}}" bindtap="onChatTap">
    <image wx:if="{{item.chat_type === 'private'}}" class="ch-avatar" src="{{defaultAvatar}}" mode="aspectFill" />
    <view wx:elif="{{item.chat_type === 'team'}}" class="ch-avatar ch-avatar-icon ch-avatar-team">
      <span class="iconfont icon-team"></span>
    </view>
    <view wx:else class="ch-avatar ch-avatar-icon ch-avatar-temp">
      <span class="iconfont icon-order"></span>
    </view>
    <view class="ch-item-body">
      <view class="ch-row-top">
        <span class="ch-name">{{item.chat_name}}</span>
        <span class="ch-time" wx:if="{{item.last_message}}">{{h.timeAgo(item.last_message.sent_at)}}</span>
      </view>
      <view class="ch-row-bottom">
        <span class="ch-last-msg" wx:if="{{item.last_message}}">{{item.last_message.sender_name}}: {{item.last_message.content}}</span>
        <span class="ch-last-msg" wx:else>暂无消息</span>
        <view class="ch-row-right">
          <span class="ch-temp-tag" wx:if="{{item.chat_type === 'schedule_temp'}}">临时</span>
          <span class="ch-unread" wx:if="{{item.unread_count > 0}}">{{item.unread_count > 99 ? '99+' : item.unread_count}}</span>
        </view>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{!loading && chats.length === 0}}">
    <span class="iconfont icon-message empty-icon"></span>
    <span class="empty-title">暂无消息</span>
  </view>

  <view class="safe-bottom" />
</view>
