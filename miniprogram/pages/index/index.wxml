<navigation-bar leftTitle="{{monthLabel}}" leftIconSize="70" leftIcon="menu" back="{{false}}" color="black" bind:tap="openDrawer"></navigation-bar>

<!-- 星期标题栏 -->
<view class="calendar-weekdays">
  <view
    class="calendar-weekday"
    wx:for="{{weekdays}}"
    wx:key="*this"
  >
    <text class="{{index >= 5 ? (index === 5 ? 'text-saturday' : 'text-sunday') : ''}}">{{item}}</text>
  </view>
</view>

<!-- 日历主体（含底部渐变遮罩） -->
<view class="calendar-container">
  <scroll-view
    scroll-y
    enhanced
    class="calendar-scroll"
    scroll-into-view="{{scrollTarget}}"
    upper-threshold="200"
    lower-threshold="200"
    bindscrolltoupper="onScrollToUpper"
    bindscrolltolower="onScrollToLower"
    bindscroll="onScroll"
  >
    <view
      class="calendar-week"
      wx:for="{{weeks}}"
      wx:key="index"
      id="week-{{index}}"
      data-month-key="{{item[0].monthKey}}"
    >
      <view class="calendar-row">
        <view
          class="calendar-cell"
          wx:for="{{item}}"
          wx:for-item="day"
          wx:key="index"
          data-week="{{index}}"
          data-day="{{day}}"
          bindtap="onDayTap"
        >
          <block wx:if="{{day.day > 0}}">
            <view class="calendar-day {{day.isToday ? 'calendar-day--today' : ''}} {{day.isSunday ? 'calendar-day--sunday' : ''}} {{day.isSaturday ? 'calendar-day--saturday' : ''}}">
              <text>{{day.day}}</text>
            </view>
            <view class="calendar-lunar">
              <text>{{day.lunar}}</text>
            </view>
            <view class="calendar-tags" wx:if="{{day.schedules.length}}">
              <view
                class="calendar-tag calendar-tag--{{schedule.type}}"
                wx:for="{{day.schedules}}"
                wx:for-item="schedule"
                wx:key="index"
              >
                <view class="calendar-tag-text">{{schedule.text}}</view>
              </view>
              <view wx:if="{{day.extraCount > 0}}" class="calendar-tag calendar-tag--more">
                <view class="calendar-tag-text">+{{day.extraCount}}</view>
              </view>
            </view>
          </block>
        </view>
      </view>
    </view>
  </scroll-view>
  <!-- 底部白色渐变遮罩 -->
  <view class="bottom-fade"></view>
  <!-- 浮动操作按钮 -->
  <view class="fab-bar">
    <view class="fab-btn fab-btn--today" bindtap="onGoToday">
      <text class="icon icon-location"></text>
      <text>今天</text>
    </view>
    <view class="fab-btn-group">
      <view class="fab-btn fab-btn--filter" bindtap="onFilterTap">
        <text class="icon icon-filter"></text>
        <text>筛选</text>
      </view>
      <view class="fab-btn fab-btn--add" bindtap="onAddSchedule">
        <text class="icon icon-plus"></text>
        <text>添加</text>
      </view>
    </view>
  </view>
</view>

<!-- 底部档期面板 -->
<view wx:if="{{panelVisible}}" class="panel-mask" bindtap="onPanelClose" catchtouchmove></view>
<view wx:if="{{panelVisible}}" class="panel" catchtap>
  <view class="panel-handle"></view>
  <view class="panel-header">
    <text class="panel-date">{{panelDate}}</text>
    <view class="panel-close" bindtap="onPanelClose">
      <text class="icon icon-close"></text>
    </view>
  </view>
  <scroll-view wx:if="{{panelSchedules.length}}" scroll-y class="panel-list">
    <view class="panel-item" wx:for="{{panelSchedules}}" wx:key="index">
      <view class="panel-item-bar panel-item-bar--{{item.type}}"></view>
      <view class="panel-item-body">
        <view class="panel-item-top">
          <text class="panel-item-title">{{item.title}}</text>
          <text class="panel-item-time">{{item.time}}</text>
        </view>
        <text class="panel-item-note" wx:if="{{item.note}}">{{item.note}}</text>
        <view class="panel-item-bottom">
          <text class="panel-item-owner">{{item.owner}}</text>
        </view>
      </view>
    </view>
  </scroll-view>
  <view wx:else class="panel-empty">
    <text class="icon icon-empty panel-empty-icon"></text>
    <text class="panel-empty-text">今天没有档期</text>
    <view class="panel-empty-btn" bindtap="onAddSchedule">
      <text class="icon icon-plus"></text>
      <text>添加档期</text>
    </view>
  </view>
</view>

<!-- 抽屉遮罩 -->
<view wx:if="{{drawerVisible}}" class="drawer-mask" bindtap="onDrawerMaskTap" catchtouchmove="onDrawerMaskTap"></view>

<!-- 抽屉主体 -->
<view wx:if="{{drawerVisible}}" class="drawer" style="animation: drawerSlideIn 0.3s ease forwards;" catchtap="">
  <view class="drawer-header" style="padding-top: {{statusBarHeight + 24}}px;">
    <view class="drawer-avatar">
      <text class="icon icon-user"></text>
    </view>
    <view class="drawer-user">
      <text class="drawer-username">用户名</text>
      <text class="drawer-role">婚礼摄影师</text>
    </view>
  </view>

  <view class="drawer-menu">
    <view
      class="drawer-menu-item"
      wx:for="{{menuList}}"
      wx:key="key"
      data-key="{{item.key}}"
      bindtap="onMenuTap"
    >
      <view class="drawer-menu-icon-wrap">
        <text class="icon {{item.icon}} drawer-menu-icon"></text>
      </view>
      <text class="drawer-menu-text">{{item.text}}</text>
      <text class="icon icon-arrow-right drawer-menu-arrow"></text>
    </view>
  </view>

  <view class="drawer-bottom">
    <view
      class="drawer-menu-item"
      wx:for="{{bottomMenu}}"
      wx:key="key"
      data-key="{{item.key}}"
      bindtap="onMenuTap"
    >
      <view class="drawer-menu-icon-wrap">
        <text class="icon {{item.icon}} drawer-menu-icon"></text>
      </view>
      <text class="drawer-menu-text">{{item.text}}</text>
    </view>
    <view style="height: {{safeAreaBottom}}px;"></view>
  </view>
</view>
