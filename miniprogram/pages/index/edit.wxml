<!--pages/index/edit.wxml-->
<navigation-bar
  title="{{isEdit ? '编辑档期' : '新建档期'}}"
  showBack="{{true}}"
  extClass="edit-nav"
/>

<scroll-view
  class="edit-page"
  scroll-y
  enhanced
  show-scrollbar="{{false}}"
  style="padding-top: calc({{statusBarHeight}}px + 88rpx);"
>
  <!-- 档期类型 -->
  <view class="form-section">
    <view class="form-label">档期类型</view>
    <view class="type-tabs">
      <view
        wx:for="{{typeOptions}}"
        wx:key="value"
        class="type-tab {{type === item.value ? 'type-tab--active type-tab--' + item.value : ''}}"
        data-value="{{item.value}}"
        bindtap="onTypeChange"
      >
        <text class="type-tab-text">{{item.label}}</text>
      </view>
    </view>
  </view>

  <!-- 休息模式：休息天数 -->
  <block wx:if="{{type === 'free'}}">
    <view class="form-section">
      <view class="form-label">休息天数</view>
      <picker mode="selector" range="{{[1,2,3,4,5,6,7]}}" value="{{restDays - 1}}" bindchange="onRestDaysChange">
        <view class="form-picker">
          <text>{{restDays}} 天</text>
          <text class="icon icon-more form-picker-arrow"></text>
        </view>
      </picker>
    </view>
    <view class="form-section">
      <view class="form-label">备注</view>
      <textarea
        class="form-textarea"
        placeholder="请输入备注"
        placeholder-class="form-placeholder"
        value="{{note}}"
        maxlength="200"
        data-field="note"
        bindinput="onInput"
      />
    </view>
  </block>

  <!-- 正常模式 -->
  <block wx:else>
    <!-- 标题 -->
    <view class="form-section">
      <view class="form-label">标题</view>
      <input
        class="form-input"
        placeholder="请输入档期标题"
        placeholder-class="form-placeholder"
        value="{{title}}"
        maxlength="50"
        bindinput="onTitleInput"
      />
    </view>

    <!-- 日期 -->
    <view class="form-section">
      <view class="form-label">日期</view>
      <picker mode="date" value="{{date}}" bindchange="onDateChange">
        <view class="form-picker">
          <text class="icon icon-clock form-field-icon"></text>
          <text>{{date || '请选择日期'}}</text>
          <text class="icon icon-more form-picker-arrow"></text>
        </view>
      </picker>
    </view>

    <!-- 时间 -->
    <view class="form-section">
      <view class="form-label">时间</view>
      <view class="time-row">
        <picker mode="time" value="{{startTime}}" bindchange="onStartTimeChange">
          <view class="form-picker form-picker--time">
            <text class="time-value">{{startTime}}</text>
          </view>
        </picker>
        <text class="time-separator">至</text>
        <picker mode="time" value="{{endTime}}" bindchange="onEndTimeChange">
          <view class="form-picker form-picker--time">
            <text class="time-value">{{endTime}}</text>
          </view>
        </picker>
      </view>
    </view>

    <!-- 来源 -->
    <view class="form-section">
      <view class="form-label">来源</view>
      <input
        class="form-input"
        placeholder="例：老客户介绍、平台推荐"
        placeholder-class="form-placeholder"
        value="{{source}}"
        maxlength="30"
        data-field="source"
        bindinput="onInput"
      />
    </view>

    <!-- 地点 -->
    <view class="form-section">
      <view class="form-label">地点</view>
      <view class="location-row">
        <input
          class="form-input location-input"
          placeholder="请输入拍摄/活动地点"
          placeholder-class="form-placeholder"
          value="{{location}}"
          maxlength="50"
          data-field="location"
          bindinput="onInput"
        />
        <view class="location-btn" bindtap="onChooseLocation">
          <text class="icon icon-location"></text>
        </view>
      </view>
    </view>

    <!-- 联系人 -->
    <view class="form-section">
      <view class="form-label-row">
        <text class="form-label">联系人</text>
        <view class="form-add-btn" bindtap="onOpenContactPanel" wx:if="{{contacts.length > 0}}">
          <text class="icon icon-plus"></text>
          <text>添加</text>
        </view>
      </view>
      <view class="contact-chips" wx:if="{{contacts.length > 0}}">
        <view class="contact-chip" wx:for="{{contacts}}" wx:key="index">
          <text class="contact-chip-role">{{item.role}}</text>
          <text class="contact-chip-name" wx:if="{{item.name}}">{{item.name}}</text>
          <text class="contact-chip-phone" wx:if="{{item.phone}}">{{item.phone}}</text>
          <text class="icon icon-delete contact-chip-remove" data-index="{{index}}" catchtap="onRemoveContact"></text>
        </view>
      </view>
      <view wx:else class="contact-empty" bindtap="onOpenContactPanel">
        <text class="icon icon-user contact-empty-icon"></text>
        <text class="contact-empty-text">点击添加联系人</text>
      </view>
    </view>

    <!-- 费用 -->
    <view class="form-section">
      <view class="form-label-row">
        <text class="form-label">费用</text>
        <view class="fee-settle-btn" bindtap="onSettleAll">
          <text>一键结清</text>
        </view>
      </view>
      <view class="fee-row">
        <view class="fee-item">
          <text class="fee-label">总价</text>
          <view class="fee-input-wrap">
            <text class="fee-currency">¥</text>
            <input
              class="form-input fee-input"
              placeholder="0"
              placeholder-class="form-placeholder"
              value="{{totalAmount}}"
              type="digit"
              data-field="totalAmount"
              bindinput="onFeeInput"
            />
          </view>
        </view>
        <view class="fee-item">
          <text class="fee-label">已付</text>
          <view class="fee-input-wrap">
            <text class="fee-currency">¥</text>
            <input
              class="form-input fee-input"
              placeholder="0"
              placeholder-class="form-placeholder"
              value="{{paidAmount}}"
              type="digit"
              data-field="paidAmount"
              bindinput="onFeeInput"
            />
          </view>
        </view>
      </view>
    </view>

    <!-- 备注 -->
    <view class="form-section">
      <view class="form-label">备注</view>
      <textarea
        class="form-textarea"
        placeholder="请输入备注"
        placeholder-class="form-placeholder"
        value="{{note}}"
        maxlength="200"
        data-field="note"
        bindinput="onInput"
      />
    </view>

    <!-- 图片 -->
    <view class="form-section">
      <view class="form-label">图片</view>
      <view class="image-grid">
        <view
          wx:for="{{images}}"
          wx:key="index"
          class="image-item"
          data-src="{{item}}"
          bindtap="onPreviewImage"
        >
          <image class="image-preview" src="{{item}}" mode="aspectFill" />
          <view class="image-remove" data-index="{{index}}" catchtap="onRemoveImage">
            <text class="icon icon-close"></text>
          </view>
        </view>
        <view wx:if="{{images.length < 3}}" class="image-add" bindtap="onChooseImage">
          <text class="icon icon-plus image-add-icon"></text>
          <text class="image-add-text">添加图片</text>
        </view>
      </view>
    </view>
  </block>

  <!-- 保存按钮 -->
  <view class="form-bottom">
    <view class="save-btn" bindtap="onSave">
      <text>{{isEdit ? '保存修改' : '创建档期'}}</text>
    </view>
  </view>
</scroll-view>

<!-- 联系人面板 -->
<view wx:if="{{contactPanelVisible}}" class="contact-panel-mask" bindtap="onCloseContactPanel" catchtouchmove></view>
<view wx:if="{{contactPanelVisible}}" class="contact-panel" catchtap>
  <view class="contact-panel-handle"></view>
  <view class="contact-panel-header">
    <text class="contact-panel-title">添加联系人</text>
    <view class="contact-panel-close" bindtap="onCloseContactPanel">
      <text class="icon icon-close"></text>
    </view>
  </view>

  <!-- 常用联系人（可滚动） -->
  <scroll-view scroll-y class="contact-panel-scroll">
    <view class="panel-section">
      <view class="panel-section-title">常用联系人</view>
      <view class="frequent-tags">
        <view
          class="frequent-tag"
          wx:for="{{frequentContacts}}"
          wx:key="index"
          data-contact="{{item}}"
          bindtap="onSelectFrequent"
        >
          <text>{{item.name}} {{item.phoneTail}}</text>
        </view>
      </view>
    </view>
  </scroll-view>

  <!-- 手动添加（固定底部） -->
  <view class="contact-panel-form">
    <view class="panel-section-title">手动添加</view>
    <view class="panel-form">
      <picker mode="selector" range="{{contactRoles}}" value="{{panelContact.roleIndex}}" bindchange="onPanelRoleChange">
        <view class="form-picker form-picker--panel">
          <text>{{panelContact.role}}</text>
          <text class="icon icon-more form-picker-arrow"></text>
        </view>
      </picker>
      <input
        class="form-input panel-form-input"
        placeholder="姓名"
        placeholder-class="form-placeholder"
        value="{{panelContact.name}}"
        maxlength="20"
        bindinput="onPanelNameInput"
      />
      <input
        class="form-input panel-form-input"
        placeholder="手机号"
        placeholder-class="form-placeholder"
        value="{{panelContact.phone}}"
        type="number"
        maxlength="11"
        bindinput="onPanelPhoneInput"
      />
      <view class="panel-confirm-btn" bindtap="onConfirmAddContact">
        <text>确认添加</text>
      </view>
    </view>
  </view>
</view>
