/* 档期卡页面 — 渐变 Hero + 白底内容 */

.sc-page {
  background: var(--color-bg-page);
  min-height: 100vh;
}

/* ====== 渐变 Hero ====== */
.sc-hero {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-bottom: var(--space-6);
  border-bottom-left-radius: var(--radius-xl);
  border-bottom-right-radius: var(--radius-xl);
}

.sc-hero-back {
  position: absolute;
  left: var(--space-3);
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-full);
  background: rgba(0,0,0,0.15);
}

.sc-hero-back-icon {
  font-size: var(--font-lg);
  color: #fff;
}

.sc-avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: var(--radius-full);
  border: 4rpx solid rgba(255,255,255,0.5);
  margin-bottom: var(--space-3);
  margin-top: var(--space-4);
}

.sc-name {
  font-size: var(--font-xl);
  font-weight: var(--weight-bold);
  color: #fff;
  margin-bottom: var(--space-1);
}

.sc-sub {
  font-size: var(--font-sm);
  color: rgba(255,255,255,0.7);
}

/* ====== 内容区 ====== */
.sc-body {
  padding: var(--space-3) var(--space-4);
}

/* ====== 通用卡片（复用 .card） ====== */
.sc-info-card {
  margin-bottom: var(--space-3);
}

/* 简介 */
.sc-bio {
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  line-height: 1.6;
  margin-bottom: var(--space-3);
}

/* 信息行 */
.sc-info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--space-2) 0;
}

.sc-info-row:not(:last-child) {
  border-bottom: 1rpx solid var(--color-border-light);
}

.sc-info-label {
  font-size: var(--font-sm);
  color: var(--color-text-tertiary);
}

.sc-info-value {
  font-size: var(--font-base);
  color: var(--color-text-primary);
  font-weight: var(--weight-medium);
}

/* ====== 卡片标题行 ====== */
.sc-card-title {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: var(--font-md);
  font-weight: var(--weight-semibold);
  color: var(--color-text-primary);
  margin-bottom: var(--space-3);
}

.sc-action-btn {
  font-size: var(--font-xs);
  color: var(--color-primary);
  font-weight: var(--weight-medium);
  padding: var(--space-1) var(--space-2);
  border-radius: var(--radius-md);
  background: var(--color-primary-light);
}

.sc-action-btn:active {
  opacity: 0.8;
}

/* ====== 档期列表 ====== */
.sc-sch-item {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  padding: var(--space-2) 0;
  font-size: var(--font-sm);
}

.sc-sch-item:not(:last-child) {
  border-bottom: 1rpx solid var(--color-border-light);
}

.sc-sch-date {
  color: var(--color-text-secondary);
  min-width: 80rpx;
  flex-shrink: 0;
  font-variant-numeric: tabular-nums;
}

.sc-sch-name {
  color: var(--color-text-primary);
  flex: 1;
  min-width: 0;
}

.sc-sch-loc {
  color: var(--color-text-tertiary);
  flex-shrink: 0;
  font-size: var(--font-xs);
}

.sc-sch-update {
  font-size: var(--font-xs);
  color: var(--color-text-tertiary);
  margin-top: var(--space-3);
  text-align: right;
}

.sc-empty {
  font-size: var(--font-sm);
  color: var(--color-text-tertiary);
  text-align: center;
  padding: var(--space-4) 0;
}

/* ====== 作品展示 ====== */
.sc-works-scroll {
  white-space: nowrap;
}

.sc-works-scroll ::-webkit-scrollbar {
  display: none;
  width: 0;
  height: 0;
  background: transparent;
}

.sc-works-list {
  display: inline-flex;
  gap: var(--space-2);
}

.sc-work-item {
  display: inline-block;
  width: 240rpx;
  flex-shrink: 0;
}

.sc-work-img {
  width: 240rpx;
  height: 180rpx;
  border-radius: var(--radius-md);
  display: block;
}

.sc-work-title {
  font-size: var(--font-xs);
  color: var(--color-text-secondary);
  margin-top: var(--space-1);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* ====== 作品全屏弹层 ====== */
.sc-works-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  background: var(--color-bg-overlay);
  display: flex;
  flex-direction: column;
}

.sc-works-overlay-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--space-3) var(--space-4);
  padding-bottom: var(--space-3);
}
}

.sc-works-overlay-title {
  font-size: var(--font-lg);
  font-weight: var(--weight-semibold);
  color: #fff;
}

.sc-works-overlay-close {
  font-size: var(--font-sm);
  color: rgba(255,255,255,0.7);
  padding: var(--space-1) var(--space-3);
  border-radius: var(--radius-md);
  background: rgba(255,255,255,0.15);
}

.sc-works-overlay-close:active {
  background: rgba(255,255,255,0.25);
}

.sc-works-overlay-scroll {
  flex: 1;
  overflow: hidden;
}

.sc-works-overlay-grid {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2);
  padding: 0 var(--space-4) var(--space-4);
}

.sc-works-overlay-item {
  width: calc(50% - var(--space-2) / 2);
}

.sc-works-overlay-img {
  width: 100%;
  height: 220rpx;
  border-radius: var(--radius-md);
  display: block;
}

.sc-works-overlay-name {
  font-size: var(--font-xs);
  color: rgba(255,255,255,0.7);
  margin-top: var(--space-1);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* ====== 加载状态 ====== */
.sc-loading {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  font-size: var(--font-base);
  color: var(--color-text-tertiary);
  background: var(--color-bg-page);
}
