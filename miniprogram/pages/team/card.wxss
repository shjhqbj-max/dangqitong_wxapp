/* 档期卡页面 — 全屏沉浸式 */

.sc-page {
  position: relative;
  background: #1a1a2e;
  color: #fff;
  padding-bottom: 160rpx;
  min-height: 100vh;
  overflow-x: hidden;
  box-sizing: border-box;
}

/* ====== 背景 ====== */
.sc-bg {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 0;
}

/* ====== 浮动顶栏 ====== */
.sc-topbar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 10;
  background: linear-gradient(to bottom, rgba(0,0,0,0.3) 0%, transparent 100%);
}

.sc-topbar-back,
.sc-topbar-share {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-full);
  background: rgba(0,0,0,0.2);
}

.sc-topbar-back {
  left: var(--space-3);
}

.sc-topbar-share {
  right: var(--space-3);
  border: none;
  margin: 0;
  padding: 0;
  line-height: 64rpx;
}

.sc-topbar-share::after {
  border: none;
}

.sc-topbar-icon {
  font-size: var(--font-lg);
  color: #fff;
}

/* ====== Hero 区 ====== */
.sc-hero {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-left: var(--space-4);
  padding-right: var(--space-4);
  padding-bottom: var(--space-6);
  transition: opacity 0.3s ease, transform 0.3s ease;
}

.sc-hero-hidden {
  opacity: 0;
  pointer-events: none;
  min-height: 240rpx;
}

.sc-avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: var(--radius-full);
  border: 4rpx solid rgba(255,255,255,0.5);
  margin-bottom: var(--space-3);
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.25);
}

.sc-name {
  font-size: var(--font-xl);
  font-weight: var(--weight-bold);
  color: #fff;
  margin-bottom: var(--space-1);
}

.sc-sub {
  font-size: var(--font-sm);
  color: rgba(255,255,255,0.7);
}

/* ====== 内容区 ====== */
.sc-body {
  position: relative;
  z-index: 1;
  padding: 0 var(--space-4);
  margin-top: var(--space-2);
}

/* ====== 深色半透明卡片 ====== */
.sc-card-dark {
  background: rgba(0,0,0,0.45);
  border: 1rpx solid rgba(255,255,255,0.12);
  border-radius: var(--radius-lg);
  padding: var(--space-4);
  margin-bottom: var(--space-3);
  color: rgba(255,255,255,0.9);
}

/* 简介 */
.sc-bio {
  font-size: var(--font-sm);
  color: rgba(255,255,255,0.7);
  line-height: 1.6;
  margin-bottom: var(--space-3);
}

/* 信息行 */
.sc-info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--space-2) 0;
}

.sc-info-row:not(:last-child) {
  border-bottom: 1rpx solid rgba(255,255,255,0.08);
}

.sc-info-label {
  font-size: var(--font-sm);
  color: rgba(255,255,255,0.5);
}

.sc-info-value {
  font-size: var(--font-base);
  color: #fff;
  font-weight: var(--weight-medium);
}

/* ====== 档期列表 ====== */
.sc-sch-title {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: var(--font-md);
  font-weight: var(--weight-semibold);
  color: #fff;
  margin-bottom: var(--space-3);
}

.sc-works-expand {
  font-size: var(--font-xs);
  color: rgba(255,255,255,0.5);
  font-weight: var(--weight-normal);
  padding: var(--space-1) var(--space-2);
  border-radius: var(--radius-md);
  background: rgba(255,255,255,0.08);
}

.sc-works-expand:active {
  background: rgba(255,255,255,0.15);
}

.sc-sch-item {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  padding: var(--space-2) 0;
  font-size: var(--font-sm);
}

.sc-sch-item:not(:last-child) {
  border-bottom: 1rpx solid rgba(255,255,255,0.06);
}

.sc-sch-date {
  color: rgba(255,255,255,0.6);
  min-width: 80rpx;
  flex-shrink: 0;
  font-variant-numeric: tabular-nums;
}

.sc-sch-name {
  color: #fff;
  flex: 1;
  min-width: 0;
}

.sc-sch-loc {
  color: rgba(255,255,255,0.4);
  flex-shrink: 0;
  font-size: var(--font-xs);
}

.sc-sch-update {
  font-size: var(--font-xs);
  color: rgba(255,255,255,0.35);
  margin-top: var(--space-3);
  text-align: right;
}

.sc-empty {
  font-size: var(--font-sm);
  color: rgba(255,255,255,0.4);
  text-align: center;
  padding: var(--space-4) 0;
}

/* ====== 作品展示 ====== */
.sc-works-scroll {
  white-space: nowrap;
}

/* 隐藏横向滚动条 */
.sc-works-scroll ::-webkit-scrollbar {
  display: none;
  width: 0;
  height: 0;
  background: transparent;
}

.sc-works-list {
  display: inline-flex;
  gap: var(--space-2);
}

.sc-work-item {
  display: inline-block;
  width: 240rpx;
  flex-shrink: 0;
}

.sc-work-img {
  width: 240rpx;
  height: 180rpx;
  border-radius: var(--radius-md);
  display: block;
}

.sc-work-title {
  font-size: var(--font-xs);
  color: rgba(255,255,255,0.6);
  margin-top: var(--space-1);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 底部占位，防止内容被固定栏遮挡 */
.sc-bottom-spacer {
  height: 160rpx;
}

/* ====== 底部操作栏 ====== */
.sc-bottom {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 10;
  display: flex;
  gap: var(--space-2);
  padding: var(--space-3) var(--space-4);
  padding-bottom: calc(var(--space-3) + env(safe-area-inset-bottom));
  background: linear-gradient(to top, rgba(26,26,46,0.95) 60%, rgba(26,26,46,0) 100%);
}

.sc-btn-save,
.sc-btn-share {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-1);
  height: 92rpx;
  border-radius: var(--radius-xl);
  font-size: var(--font-base);
  font-weight: var(--weight-medium);
}

.sc-btn-save {
  background: rgba(255,255,255,0.12);
  color: #fff;
  border: 1rpx solid rgba(255,255,255,0.2);
  transition: background 0.2s ease;
}

.sc-btn-save:active {
  background: rgba(255,255,255,0.22);
}

.sc-btn-share {
  background: rgba(255,255,255,0.92);
  color: #1a1a2e;
  border: none;
  margin: 0;
  padding: 0;
  line-height: 92rpx;
  border-radius: var(--radius-xl);
  transition: background 0.2s ease;
}

.sc-btn-share::after {
  border: none;
}

.sc-btn-share:active {
  background: rgba(255,255,255,0.8);
}

.sc-btn-icon {
  font-size: var(--font-md);
}

/* ====== 作品全屏弹层 ====== */
.sc-works-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  background: rgba(10,10,20,0.97);
  display: flex;
  flex-direction: column;
}

.sc-works-overlay-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--space-3) var(--space-4);
  padding-top: calc(var(--space-3) + env(safe-area-inset-top));
}

.sc-works-overlay-title {
  font-size: var(--font-lg);
  font-weight: var(--weight-semibold);
  color: #fff;
}

.sc-works-overlay-close {
  font-size: var(--font-sm);
  color: rgba(255,255,255,0.6);
  padding: var(--space-1) var(--space-3);
  border-radius: var(--radius-md);
  background: rgba(255,255,255,0.1);
}

.sc-works-overlay-close:active {
  background: rgba(255,255,255,0.2);
}

.sc-works-overlay-scroll {
  flex: 1;
  overflow: hidden;
}

.sc-works-overlay-grid {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2);
  padding: 0 var(--space-4) var(--space-4);
}

.sc-works-overlay-item {
  width: calc(50% - var(--space-2) / 2);
}

.sc-works-overlay-img {
  width: 100%;
  height: 220rpx;
  border-radius: var(--radius-md);
  display: block;
}

.sc-works-overlay-name {
  font-size: var(--font-xs);
  color: rgba(255,255,255,0.6);
  margin-top: var(--space-1);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* ====== 加载状态 ====== */
.sc-loading {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  font-size: var(--font-base);
  color: rgba(255,255,255,0.5);
  background: #1a1a2e;
}
