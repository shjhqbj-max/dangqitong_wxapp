<wxs module="h" src="../../utils/helpers.wxs" />
<nav-bar title="团队管理" />

<!-- 团队信息 Hero -->
<view class="m-hero card-top">
  <view class="m-hero-main">
    <span class="m-hero-name">{{team.name || '团队'}}</span>
    <span class="m-hero-count">{{members.length}}人</span>
  </view>
  <span class="iconfont icon-edit m-hero-edit" wx:if="{{isAdmin}}" bindtap="onEditName"></span>
</view>

<!-- 成员列表 -->
<view class="m-section">
  <view class="card m-member-card">
    <view class="m-item" wx:for="{{members}}" wx:key="user_id"
      data-uid="{{item.user_id}}" bindtap="onMemberTap">
      <image class="m-avatar" src="{{item.avatar_url}}" mode="aspectFill" />
      <view class="m-info">
        <span class="m-name">{{item.nickname}}</span>
        <view class="m-pros">
          <span wx:for="{{item.professions}}" wx:key="*this" wx:for-item="pro"
            class="m-pro pro-{{h.getProClass(pro)}}">{{pro}}</span>
        </view>
      </view>
      <view class="badge {{item.role === 'admin' ? 'badge-confirmed' : ''}} m-role-badge">
        {{item.role === 'admin' ? '管理员' : '成员'}}
      </view>
      <span class="iconfont icon-more m-action" wx:if="{{isAdmin && item.user_id !== 'u-001'}}"
            data-idx="{{index}}" catchtap="onMemberAction" />
    </view>
  </view>
</view>

<!-- 邀请区 -->
<view class="m-section">
  <view class="card m-invite-card">
    <!-- 邀请码 -->
    <view class="m-invite-row">
      <view class="m-invite-left">
        <span class="iconfont icon-schedule m-invite-icon"></span>
        <view class="m-invite-text">
          <span class="m-invite-label">邀请码</span>
          <span class="m-invite-code">{{inviteCode}}</span>
        </view>
      </view>
      <view class="m-invite-btn" bindtap="onCopyInvite">复制</view>
    </view>
    <!-- 分割线 -->
    <view class="m-invite-divider"></view>
    <!-- 邀请链接 -->
    <view class="m-invite-row">
      <view class="m-invite-left">
        <span class="iconfont icon-share m-invite-icon"></span>
        <view class="m-invite-text">
          <span class="m-invite-label">邀请链接</span>
          <span class="m-invite-link-text">分享链接邀请成员加入</span>
        </view>
      </view>
      <view class="m-invite-btn" bindtap="onShareInvite">分享</view>
    </view>
  </view>
</view>

<!-- 退出团队 -->
<view class="m-section" wx:if="{{!isAdmin}}">
  <view class="m-leave" bindtap="onLeaveTeam">退出团队</view>
</view>

<view class="safe-bottom" />
