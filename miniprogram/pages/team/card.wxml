<wxs module="h" src="../../utils/helpers.wxs" />

<!-- 档期卡页面 -->
<view class="sc-page" wx:if="{{card}}">
  <!-- 背景渐变 -->
  <view class="sc-bg" style="background: {{bgGradient}}"></view>

  <!-- 浮动顶栏 -->
  <view class="sc-topbar" style="{{topbarStyle}}">
    <view class="sc-topbar-back" bindtap="onBack">
      <view class="iconfont icon-arrow-left sc-topbar-icon"></view>
    </view>
  </view>

  <!-- 头像 + 基本信息 -->
  <view class="sc-hero {{heroHidden ? 'sc-hero-hidden' : ''}}" style="{{heroStyle}}">
    <image class="sc-avatar" src="{{card.avatar_url}}" mode="aspectFill" />
    <view class="sc-name">{{card.nickname}}</view>
    <view class="sc-sub">
      <view>{{card.profession}}</view>
      <view wx:if="{{card.city}}"> · {{card.city}}</view>
    </view>
  </view>

  <!-- 内容区（原生滚动） -->
  <view class="sc-body">
    <!-- 信息卡 -->
    <view class="sc-card-dark">
      <view class="sc-bio" wx:if="{{card.bio}}">{{card.bio}}</view>
      <view class="sc-info-row">
        <view class="sc-info-label">报价</view>
        <view class="sc-info-value">{{card.price_text}}</view>
      </view>
      <view class="sc-info-row" wx:if="{{card.phone}}">
        <view class="sc-info-label">电话</view>
        <view class="sc-info-value">{{card.phone}}</view>
      </view>
    </view>

    <!-- 档期列表 -->
    <view class="sc-card-dark" wx:if="{{card.schedules.length > 0}}">
      <view class="sc-sch-title">已定档期</view>
      <view class="sc-sch-item" wx:for="{{card.schedules}}" wx:key="index">
        <view class="sc-sch-date">{{item.date}}</view>
        <view class="sc-sch-name">{{item.title}}</view>
        <view class="sc-sch-loc">{{h.getLocationShort(item.location)}}</view>
      </view>
      <view class="sc-sch-update">更新于 {{card.updated_at}}</view>
    </view>

    <!-- 空状态 -->
    <view class="sc-card-dark" wx:if="{{card.schedules.length === 0}}">
      <view class="sc-sch-title">已定档期</view>
      <view class="sc-empty">暂无档期安排</view>
    </view>

    <!-- 作品展示 -->
    <view class="sc-card-dark" wx:if="{{card.works.length > 0}}">
      <view class="sc-sch-title">
        <view>作品展示</view>
        <view class="sc-works-expand" bindtap="onExpandWorks">展开</view>
      </view>
      <scroll-view class="sc-works-scroll" scroll-x enable-flex>
        <view class="sc-works-list">
          <view class="sc-work-item" wx:for="{{card.works}}" wx:key="index">
            <image class="sc-work-img" src="{{item.image_url}}" mode="aspectFill" />
            <view class="sc-work-title" wx:if="{{item.title}}">{{item.title}}</view>
          </view>
        </view>
      </scroll-view>
    </view>

    <!-- 底部占位，避免被固定栏遮挡 -->
    <view class="sc-bottom-spacer"></view>
  </view>

  <!-- 底部操作栏 -->
  <view class="sc-bottom">
    <view class="sc-btn-save" bindtap="onSaveImage">
      <view class="iconfont icon-image sc-btn-icon"></view>
      <view>保存图片</view>
    </view>
    <button class="sc-btn-share" open-type="share">
      <view class="iconfont icon-share sc-btn-icon"></view>
      <view>分享给好友</view>
    </button>
  </view>

  <!-- 作品全屏弹层 -->
  <view class="sc-works-overlay" wx:if="{{showWorksFull}}">
    <view class="sc-works-overlay-bar">
      <view class="sc-works-overlay-title">作品展示</view>
      <view class="sc-works-overlay-close" bindtap="onCloseWorksFull">关闭</view>
    </view>
    <scroll-view class="sc-works-overlay-scroll" scroll-y enable-flex>
      <view class="sc-works-overlay-grid">
        <view class="sc-works-overlay-item" wx:for="{{card.works}}" wx:key="index">
          <image class="sc-works-overlay-img" src="{{item.image_url}}" mode="aspectFill" />
          <view class="sc-works-overlay-name" wx:if="{{item.title}}">{{item.title}}</view>
        </view>
      </view>
    </scroll-view>
  </view>
</view>

<!-- 加载中 -->
<view class="sc-loading" wx:if="{{loading}}">
  <view>加载中...</view>
</view>
