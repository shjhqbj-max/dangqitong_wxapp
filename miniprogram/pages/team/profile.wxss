/* 团队对外展示页 */

.tp-page {
  background: var(--color-bg-page);
  min-height: 100vh;
}

/* ====== 固定头部 ====== */
.tp-header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 50;
}

/* ====== Hero 封面 ====== */
.tp-hero {
  position: relative;
}

.tp-cover {
  width: 100%;
  height: 440rpx;
  display: block;
}

.tp-hero-mask {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 50%;
  background: linear-gradient(to top, var(--color-bg-page) 0%, transparent 100%);
  z-index: 1;
}

.tp-hero-back {
  position: absolute;
  left: var(--space-3);
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-full);
  background: rgba(0,0,0,0.2);
  z-index: 2;
}

.tp-hero-back-icon {
  font-size: var(--font-lg);
  color: #fff;
}

/* ====== 信息 + Tab 栏 ====== */
.tp-info-bar {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: var(--space-3) var(--space-4) var(--space-2);
  background: var(--color-bg-page);
}

.tp-info-left {
  flex: 1;
  min-width: 0;
}

.tp-team-name {
  font-size: var(--font-xl);
  font-weight: var(--weight-bold);
  color: var(--color-text-primary);
  margin-bottom: var(--space-0-5);
}

.tp-team-meta {
  font-size: var(--font-xs);
  color: var(--color-text-tertiary);
}

.tp-tabs {
  display: flex;
  gap: var(--space-1);
  flex-shrink: 0;
}

.tp-tab {
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  padding: var(--space-1) var(--space-2-5);
  border-radius: var(--radius-full);
  transition: all 0.2s ease;
}

.tp-tab-active {
  background: var(--color-primary);
  color: var(--color-on-primary);
  font-weight: var(--weight-medium);
}

/* ====== 内容区 ====== */
.tp-body {
  padding: var(--space-3) var(--space-4);
}

/* ====== 作品网格 ====== */
.tp-works-grid {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2);
}

.tp-work-card {
  width: calc(50% - var(--space-2) / 2);
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: var(--shadow-sm);
}

.tp-work-card:active {
  transform: scale(0.98);
}

.tp-work-img {
  width: 100%;
  height: 240rpx;
  display: block;
}

.tp-work-info {
  display: flex;
  align-items: center;
  gap: var(--space-1-5);
  padding: var(--space-2) var(--space-2);
}

.tp-work-avatar {
  width: 40rpx;
  height: 40rpx;
  border-radius: var(--radius-full);
  flex-shrink: 0;
}

.tp-work-meta {
  flex: 1;
  min-width: 0;
}

.tp-work-nick {
  font-size: var(--font-xs);
  color: var(--color-text-primary);
  font-weight: var(--weight-medium);
}

.tp-work-title {
  font-size: var(--font-xs);
  color: var(--color-text-tertiary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* ====== 成员卡片 ====== */
.tp-member-card {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  padding: var(--space-3) !important;
  margin-bottom: var(--space-2);
}

.tp-member-card:active {
  transform: scale(0.985);
}

.tp-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: var(--radius-full);
  flex-shrink: 0;
}

.tp-member-body {
  flex: 1;
  min-width: 0;
}

.tp-member-top {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  margin-bottom: var(--space-0-5);
}

.tp-member-name {
  font-size: var(--font-md);
  font-weight: var(--weight-semibold);
  color: var(--color-text-primary);
}

.tp-member-pro {
  font-size: var(--font-xs);
  flex-shrink: 0;
}

.tp-member-price {
  font-size: var(--font-sm);
  color: var(--color-text-tertiary);
}

.tp-phone {
  width: 72rpx;
  height: 72rpx;
  border-radius: var(--radius-full);
  background: var(--color-danger-light);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.tp-phone:active {
  background: var(--color-danger);
}

.tp-phone-icon {
  font-size: var(--font-lg);
  color: var(--color-danger);
}

.tp-phone:active .tp-phone-icon {
  color: var(--color-on-primary);
}

/* ====== 空状态 ====== */
.tp-empty {
  text-align: center;
  padding: var(--space-10) 0;
  font-size: var(--font-sm);
  color: var(--color-text-tertiary);
}

/* ====== 加载状态 ====== */
.tp-loading {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  font-size: var(--font-base);
  color: var(--color-text-tertiary);
  background: var(--color-bg-page);
}
