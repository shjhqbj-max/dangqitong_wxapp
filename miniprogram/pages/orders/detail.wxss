/* 订单详情页 */
.detail-page {
  min-height: 100vh;
}

/* ====== Hero 头部 ====== */
.detail-hero {
  position: fixed;
  top: -1px;
  left: 0;
  right: 0;
  z-index: 50;
  background: var(--color-bg-card);
  box-shadow: var(--shadow-b);
}

.hero-content {
  padding: var(--space-4) var(--space-4) var(--space-3);
}

.hero-top {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: var(--space-2-5);
}

.hero-date {
  display: flex;
  align-items: flex-end;
  gap: var(--space-1-5);
}

.hero-date-day {
  font-size: 96rpx;
  font-weight: var(--weight-bold);
  line-height: 1;
  color: var(--color-text-primary);
}

.hero-date-info {
  display: flex;
  flex-direction: column;
  gap: var(--space-1);
  padding-bottom: var(--space-1-5);
}

.hero-date-sub {
  font-size: var(--font-base);
  color: var(--color-text-secondary);
}

.hero-date-badges {
  display: flex;
  gap: var(--space-1);
  align-items: center;
}

.hero-badge {
  display: inline-flex;
  align-items: center;
  font-size: var(--font-sm);
  padding: var(--space-0-5) var(--space-2);
  border-radius: var(--radius-full);
  background: var(--color-bg-muted);
  color: var(--color-text-secondary);
}

.badge-active {
  background: rgba(34, 197, 94, 0.1);
  color: #22c55e;
}

.badge-grabbed {
  background: var(--color-primary-light);
  color: var(--color-primary);
}

.badge-completed {
  background: var(--color-bg-muted);
  color: var(--color-text-tertiary);
}

.badge-closed {
  background: var(--color-bg-muted);
  color: var(--color-text-placeholder);
}

.hero-price-box {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4rpx;
}

.hero-price {
  font-size: var(--font-2xl);
  font-weight: var(--weight-bold);
  color: var(--color-primary);
}

.hero-deadline {
  font-size: var(--font-xs);
  color: var(--color-text-tertiary);
}

.hero-meta {
  display: flex;
  flex-direction: column;
  gap: var(--space-1);
}

.hero-time-row {
  display: flex;
  align-items: center;
  gap: var(--space-1);
}

.hero-meta-icon {
  font-size: var(--font-sm);
  color: var(--color-text-tertiary);
}

.hero-time-text {
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
}

.hero-actions {
  display: flex;
  gap: var(--space-2);
  margin-top: var(--space-3);
  padding-top: var(--space-3);
  border-top: 1rpx solid var(--color-border-light);
}

.hero-action-btn {
  flex: 1;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-1);
  border-radius: var(--radius-lg);
  font-size: var(--font-base);
  font-weight: var(--weight-medium);
  background: var(--color-bg-muted);
  color: var(--color-text-primary);
}

.hero-action-btn-grab {
  background: var(--color-primary);
  color: var(--color-on-primary);
  box-shadow: var(--shadow-primary);
}

.hero-action-btn-grabbed {
  background: var(--color-success-light);
  color: var(--color-success);
}

.hero-action-btn-disabled {
  background: var(--color-bg-muted);
  color: var(--color-text-placeholder);
}

/* ====== 内容区 ====== */
.detail-body {
  padding: 0 var(--space-3);
}

/* 职业标签 */
.order-pro-tag {
  display: inline-flex;
  align-items: center;
  gap: 4rpx;
  font-size: var(--font-xs);
  font-weight: var(--weight-medium);
  padding: var(--space-0-5) var(--space-1-5);
  border-radius: var(--radius-full);
  background: var(--color-bg-muted);
  margin-left: auto;
}

.order-pro-tag .iconfont {
  font-size: var(--font-xs);
}

/* 发布者行 */
.publisher-row {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  padding: var(--space-1) 0;
}

.publisher-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: var(--radius-full);
  flex-shrink: 0;
}

.publisher-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.publisher-name {
  font-size: var(--font-base);
  font-weight: var(--weight-medium);
  color: var(--color-text-primary);
}

.publisher-time {
  font-size: var(--font-xs);
  color: var(--color-text-tertiary);
}

.publisher-contact {
  display: inline-flex;
  align-items: center;
  gap: var(--space-0-5);
  padding: var(--space-1) var(--space-2);
  border-radius: var(--radius-full);
  background: var(--color-primary-light);
  color: var(--color-primary);
  font-size: var(--font-sm);
  font-weight: var(--weight-medium);
}

.publisher-contact .iconfont {
  font-size: var(--font-sm);
}

/* 描述 */
.desc-content {
  font-size: 28rpx;
  color: var(--color-text-primary);
  line-height: 1.7;
  white-space: pre-wrap;
}

/* 抢单列表 */
.grabber-item {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  padding: var(--space-2) 0;
  border-bottom: 1rpx solid var(--color-border-light);
}

.grabber-item:last-child {
  border-bottom: none;
}

.grabber-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: var(--radius-full);
  flex-shrink: 0;
}

.grabber-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}

.grabber-name {
  font-size: var(--font-base);
  color: var(--color-text-primary);
  font-weight: var(--weight-medium);
}

.grabber-meta {
  font-size: var(--font-xs);
  color: var(--color-text-tertiary);
}

.grabber-time {
  font-size: var(--font-xs);
  color: var(--color-text-placeholder);
  flex-shrink: 0;
}

/* 角色需求 */
.role-slot {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  padding: var(--space-2) 0;
  border-bottom: 1rpx solid var(--color-border-light);
}

.role-slot:last-child {
  border-bottom: none;
}

.role-pro {
  flex: 1;
  font-size: var(--font-base);
  font-weight: var(--weight-medium);
  padding: var(--space-0-5) var(--space-2);
  border-radius: var(--radius-full);
  background: var(--color-bg-muted);
  text-align: center;
}

.role-price {
  flex: 1;
  font-size: var(--font-base);
  font-weight: var(--weight-medium);
  color: var(--color-primary);
  text-align: center;
}

.role-count {
  flex: 1;
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  text-align: center;
}

.role-count-full {
  color: var(--color-text-placeholder);
  text-decoration: line-through;
}

.role-status {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  font-size: var(--font-xs);
  color: var(--color-text-tertiary);
}

.role-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: var(--radius-full);
  background: var(--color-success, #22c55e);
}

.role-dot-full {
  background: var(--color-text-placeholder);
}

/* 操作链接 */
.action-links {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--space-3) 0;
  margin-top: var(--space-3);
}

.action-link {
  font-size: var(--font-base);
  color: var(--color-text-tertiary);
  padding: var(--space-1) var(--space-2-5);
  font-weight: var(--weight-medium);
  display: inline-flex;
  align-items: center;
  gap: var(--space-1);
}

.action-link-icon {
  font-size: var(--font-sm);
}
