<!-- 发单页（发布工单） -->
<wxs module="h" src="../../utils/helpers.wxs" />

<view class="publish-page">
  <!-- Hero 头部（与 nav-bar 一体） -->
  <view class="publish-hero card-top">
    <view class="hero-content">
      <view class="hero-top">
        <view class="hero-date">
          <span class="hero-date-day">{{form.date ? h.getDayNum(form.date) : '--'}}</span>
          <view class="hero-date-sub">
            <span wx:if="{{form.date}}">{{h.getYear(form.date)}}年{{h.getMonth(form.date)}}月</span>
            <picker mode="date" value="{{form.date}}" bindchange="onDateChange">
              <span class="iconfont icon-edit hero-date-edit"></span>
            </picker>
          </view>
        </view>
        <view class="hero-badge-box" wx:if="{{professionSlots.length > 0}}">
          <block wx:if="{{professionSlots.length <= 1}}">
            <view class="hero-pro-badge" wx:for="{{professionSlots}}" wx:key="profession">
              <span class="iconfont icon-job"></span>
              <span>{{item.profession}}</span>
            </view>
          </block>
          <view class="hero-pro-badge" wx:elif="{{professionSlots.length > 1}}">
            <span class="iconfont icon-job"></span>
            <span>多职业</span>
          </view>
        </view>
      </view>
      <view class="hero-meta">
        <picker mode="multiSelector" range="{{timeRanges}}" value="{{timeValues}}" bindchange="onTimeChange">
          <view class="hero-time-capsule">
            <span class="hero-time-text">{{form.start_time || '开始'}}</span>
            <span class="hero-time-sep">~</span>
            <span class="hero-time-text">{{form.end_time || '结束'}}</span>
            <span class="iconfont icon-edit hero-time-edit"></span>
          </view>
        </picker>
      </view>
      <view class="hero-actions">
        <view class="hero-action-btn hero-action-btn-save" bindtap="onSave">发布</view>
        <view class="hero-action-btn" bindtap="onCancel">取消</view>
      </view>
    </view>
  </view>

  <!-- 内容区 -->
  <view class="publish-body" style="padding-top: {{heroH}}rpx">
    <!-- 基本信息 -->
    <view class="info-card">
      <view class="info-card-header">
        <span class="iconfont icon-order info-card-icon"></span>
        <span class="info-card-title">基本信息</span>
      </view>
      <view class="form-row">
        <span class="form-label">标题</span>
        <input class="form-input" placeholder="请输入工单标题" value="{{form.title}}" bindinput="onFieldInput" data-field="title" />
      </view>
      <view class="form-row">
        <span class="form-label">职业</span>
        <view class="form-picker-value" bindtap="onToggleProSheet">
          <span>{{professionLabel}}</span>
          <span class="iconfont icon-chevron-right form-picker-arrow"></span>
        </view>
      </view>
      <!-- 角色详情行 -->
      <view class="slot-list" wx:if="{{professionSlots.length > 0}}">
        <view class="slot-row" wx:for="{{professionSlots}}" wx:key="profession">
          <view class="slot-pro">{{item.profession}}</view>
          <view class="slot-fields">
            <view class="slot-field">
              <span class="slot-field-label">¥</span>
              <input class="slot-field-input" type="digit" placeholder="价格" value="{{item.price}}"
                     bindinput="onSlotPriceInput" data-idx="{{index}}" />
            </view>
            <view class="slot-field">
              <input class="slot-field-input slot-field-num" type="number" placeholder="1" value="{{item.need_count}}"
                     bindinput="onSlotCountInput" data-idx="{{index}}" />
              <span class="slot-field-label">人</span>
            </view>
          </view>
          <view class="slot-remove" bindtap="onRemoveSlot" data-idx="{{index}}">
            <span class="iconfont icon-close"></span>
          </view>
        </view>
        <view class="slot-total" wx:if="{{totalPrice > 0}}">
          <span>合计</span>
          <span class="slot-total-price">¥{{totalPrice}}</span>
        </view>
      </view>
      <view class="form-row">
        <span class="form-label">地点</span>
        <view class="form-input-group">
          <input class="form-input" placeholder="请输入或选择地点" value="{{form.location}}" bindinput="onFieldInput" data-field="location" />
          <view class="form-loc-icon" bindtap="onChooseLocation">
            <span class="iconfont icon-location"></span>
          </view>
        </view>
      </view>
    </view>

    <!-- 联系方式 -->
    <view class="info-card">
      <view class="info-card-header">
        <span class="iconfont icon-phone info-card-icon"></span>
        <span class="info-card-title">联系方式</span>
      </view>
      <view class="form-row">
        <span class="form-label">电话</span>
        <input class="form-input" type="number" placeholder="选填" value="{{form.contact}}" bindinput="onFieldInput" data-field="contact" />
      </view>
    </view>

    <!-- 截止时间 -->
    <view class="info-card">
      <view class="info-card-header">
        <span class="iconfont icon-clock info-card-icon"></span>
        <span class="info-card-title">截止时间</span>
      </view>
      <view class="form-row">
        <span class="form-label">截止</span>
        <picker mode="date" value="{{form.deadline.substring(0, 10)}}" bindchange="onDeadlineChange">
          <view class="form-picker-row">
            <span class="form-picker-text {{form.deadline ? '' : 'form-picker-placeholder'}}">{{form.deadline ? h.formatDateShort(form.deadline.substring(0, 10)) : '请选择截止时间'}}</span>
            <span class="iconfont icon-chevron-right form-picker-arrow"></span>
          </view>
        </picker>
      </view>
    </view>

    <!-- 描述 -->
    <view class="info-card">
      <view class="info-card-header">
        <span class="iconfont icon-note info-card-icon"></span>
        <span class="info-card-title">需求描述</span>
      </view>
      <textarea class="form-textarea" placeholder="详细描述你的需求，如风格要求、设备要求、经验要求等" value="{{form.description}}" bindinput="onFieldInput" data-field="description" maxlength="500" />
    </view>

    <view class="safe-bottom"></view>
  </view>

  <!-- 职业选择底部弹出（多选） -->
  <view class="filter-mask" wx:if="{{showProSheet}}" bindtap="onCloseProSheet"></view>
  <view class="filter-sheet {{showProSheet ? 'filter-sheet-show' : ''}}">
    <view class="filter-sheet-header">
      <span class="filter-sheet-title">选择职业（可多选）</span>
      <span class="iconfont icon-close filter-sheet-close" bindtap="onCloseProSheet"></span>
    </view>
    <view class="filter-sheet-body">
      <view class="pro-sheet-grid">
        <view class="pro-sheet-item {{selectedProSet[item.label] ? 'pro-sheet-item-active' : ''}}"
              wx:for="{{professions}}" wx:key="label" bindtap="onProfessionSelect" data-value="{{item.label}}">
          <span class="pro-sheet-dot pro-{{item.css}}">●</span>
          <span>{{item.label}}</span>
          <span class="pro-sheet-check iconfont icon-close" wx:if="{{selectedProSet[item.label]}}"></span>
        </view>
      </view>
    </view>
    <view class="filter-sheet-footer">
      <view class="filter-sheet-btn" bindtap="onCloseProSheet">确认（{{professionSlots.length}}）</view>
    </view>
  </view>
</view>
