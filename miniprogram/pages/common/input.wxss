/* 公共输入页 */

/* ====== 页面 ====== */
page {
  background: var(--color-bg-card);
}

.ci-page {
  padding: var(--space-4) var(--space-4) 0;
}

/* ====== 单行输入框 ====== */
.ci-field {
  display: flex;
  align-items: center;
  background: var(--color-bg-muted);
  border-radius: var(--radius-lg);
  padding: 0 var(--space-3);
  height: 96rpx;
  box-sizing: border-box;
}

.ci-input {
  flex: 1;
  font-size: var(--font-md);
  color: var(--color-text-primary);
  height: 96rpx;
  line-height: 96rpx;
  background: transparent;
}

.ci-clear {
  flex-shrink: 0;
  width: 36rpx;
  height: 36rpx;
  border-radius: var(--radius-full);
  background: var(--color-text-tertiary);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: var(--space-2);
}

.ci-clear-icon {
  font-size: 20rpx;
  color: var(--color-on-primary);
}

/* ====== 多行输入框 ====== */
.ci-textarea-field {
  background: var(--color-bg-muted);
  border-radius: var(--radius-lg);
  padding: var(--space-3);
}

.ci-textarea {
  width: 100%;
  font-size: var(--font-md);
  color: var(--color-text-primary);
  line-height: var(--leading-relaxed);
  min-height: 240rpx;
  background: transparent;
}

.ci-count {
  text-align: right;
  font-size: var(--font-xs);
  color: var(--color-text-tertiary);
  margin-top: var(--space-2);
}

/* ====== 底部固定操作栏 ====== */
.ci-footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: var(--space-3) var(--space-4);
  padding-bottom: calc(var(--space-3) + env(safe-area-inset-bottom, 0px));
  background: var(--color-bg-card);
}

.ci-save {
  text-align: center;
  font-size: var(--font-md);
  font-weight: var(--weight-semibold);
  color: var(--color-on-primary);
  background: var(--color-primary);
  border-radius: var(--radius-lg);
  padding: var(--space-3);
  box-shadow: var(--shadow-primary);
}

.ci-save:active {
  opacity: 0.85;
}

.ci-save-disabled {
  opacity: 0.5;
  pointer-events: none;
}

/* ====== 发布作品：图片预览 ====== */
.ci-work-image-wrap {
  position: relative;
  border-radius: var(--radius-lg);
  overflow: hidden;
  margin-bottom: var(--space-4);
}

.ci-work-image {
  width: 100%;
  height: 480rpx;
  display: block;
}

.ci-work-image-tip {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-1);
  padding: var(--space-2);
  background: linear-gradient(transparent, rgba(0,0,0,0.5));
  font-size: var(--font-xs);
  color: #FFFFFF;
}

.ci-work-image-tip-icon {
  font-size: var(--font-sm);
}

.ci-work-no-image {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: var(--space-2);
  height: 360rpx;
  border-radius: var(--radius-lg);
  border: 2rpx dashed var(--color-border);
  margin-bottom: var(--space-4);
}

.ci-work-no-image-icon {
  font-size: 72rpx;
  color: var(--color-text-tertiary);
}

.ci-work-no-image-text {
  font-size: var(--font-sm);
  color: var(--color-text-tertiary);
}

.ci-work-title-field {
  margin-top: var(--space-3);
}

/* ====== 发布动态：视频链接 ====== */
.ci-post-hint {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  padding: var(--space-3) var(--space-4);
  margin-bottom: var(--space-4);
  border-radius: var(--radius-md);
  background: var(--color-bg-muted);
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
}

.ci-post-hint-icon {
  font-size: var(--font-lg);
  color: var(--color-primary);
}
